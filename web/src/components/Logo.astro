---
// Sikhi University crest: an open granth resting on a lotus cradle beneath a
// domed arch, set in a seal — outer mala (rosary) ring with its sumeru bead at
// the base, inner ring with a keystone bead at the crown. The granth pages are
// deliberately blank line-art (never implied text — reverence rule).
// Single colour via currentColor, so set a text-* class.
interface Props { class?: string; }
const { class: cls = '' } = Astro.props;
---
<svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class={cls}>
  <!-- Mala ring with sumeru bead at the base -->
  <circle cx="32" cy="32" r="29" stroke-width="2.1" stroke-dasharray="0.1 5.05" />
  <circle cx="32" cy="61" r="2.7" fill="currentColor" stroke="none" />
  <!-- Inner seal ring with keystone bead at the crown -->
  <circle cx="32" cy="32" r="24" stroke-width="1.2" />
  <circle cx="32" cy="8" r="1.6" fill="currentColor" stroke="none" />
  <!-- Domed arch over the granth, with an engraved inner echo -->
  <path d="M18.5 28 Q22.5 15.2 32 13.5 Q41.5 15.2 45.5 28" stroke-width="2.2" />
  <path d="M23.5 27 Q26.5 17.8 32 16.5 Q37.5 17.8 40.5 27" stroke-width="1.1" />
  <!-- Open granth (blank pages) -->
  <path d="M32 45 C28.5 41.8 24 41 19.5 42.2 C18.9 42.35 18.5 42 18.5 41.4 L18.5 33 C18.5 32.55 18.8 32.15 19.2 32 C23.8 30.7 28.6 31.6 32 34.4" stroke-width="2.2" />
  <path d="M32 45 C35.5 41.8 40 41 44.5 42.2 C45.1 42.35 45.5 42 45.5 41.4 L45.5 33 C45.5 32.55 45.2 32.15 44.8 32 C40.2 30.7 35.4 31.6 32 34.4" stroke-width="2.2" />
  <path d="M32 34.4 L32 45" stroke-width="1.5" />
  <!-- Lotus cradle base -->
  <path d="M24.5 48.6 Q32 52.2 39.5 48.6" stroke-width="2" />
  <path d="M28.5 51.4 Q32 53 35.5 51.4" stroke-width="1.4" />
</svg>
