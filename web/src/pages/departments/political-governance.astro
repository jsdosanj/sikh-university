---
import Base from '../../layouts/Base.astro';
import '../../styles/departments.css';
import DeptHero from '../../components/departments/DeptHero.astro';
import DeptSections from '../../components/departments/DeptSections.astro';
import { departments } from '../../lib/departments';
const d = departments.find((x) => x.id === 'political-governance')!;
const ld = {
  '@context': 'https://schema.org', '@type': 'EducationalOrganization',
  name: `${d.name}, Sikhi University`, description: d.blurb,
  url: 'https://sikhiuni.com/departments/political-governance',
  parentOrganization: { '@type': 'CollegeOrUniversity', name: 'Sikhi University', url: 'https://sikhiuni.com/' },
};
const institutions = [
  ['Saṅgat', 'The congregation — where authority sits with the gathered, not a clergy.'],
  ['Paṅgat &amp; Laṅgar', 'Everyone eats in one row. The kitchen is a political statement.'],
  ['Panj Pyāre', 'Five, chosen and equal, act for the whole. Leadership without a throne.'],
  ['Gurmatā', 'A decision taken in the presence of the Guru, binding on the Panth.'],
  ['Sarbat Khālsā', 'The whole Panth in assembly — the highest collective body.'],
  ['Akāl Takht', 'The seat of temporal authority, facing Darbār Sāhib. Mīrī and Pīrī together.'],
];
---
<Base title={`${d.name} — Sikhi University`} description={d.blurb} ambient="none">
  <script type="application/ld+json" set:html={JSON.stringify(ld)} slot="head" />
  <div class="dept-page" style={`--dept:${d.accent}`}>
    <DeptHero d={d}>
      <section class="pg-sig" aria-label="The institutions of the Panth">
        <div class="wrap">
          <div class="pg-mark" aria-hidden="true">
            <svg viewBox="0 0 120 60" width="120" height="60" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round">
              <path d="M20 8 C 40 24, 40 36, 20 52" />
              <path d="M100 8 C 80 24, 80 36, 100 52" />
              <circle cx="60" cy="30" r="9" />
              <path d="M60 4v10M60 46v10" />
            </svg>
          </div>
          <p class="pg-sig-kicker">Mīrī &amp; Pīrī — the temporal and the spiritual, held together</p>
          <h2 class="pg-sig-h">The Gurus built institutions, not just ideas</h2>
          <ol class="pg-list">
            {institutions.map(([t, b], i) => (
              <li class="pg-node" style={`--i:${i}`}>
                <span class="pg-dot" aria-hidden="true"></span>
                <span class="pg-t" set:html={t} />
                <span class="pg-b" set:html={b} />
              </li>
            ))}
          </ol>
          <p class="pg-sig-note">The department studies each of these as something meant to be practised — sovereignty you can run, not just admire.</p>
        </div>
      </section>
    </DeptHero>
    <DeptSections d={d} />
  </div>

  <style>
    .pg-sig { background: linear-gradient(180deg, #1e1330, #150d24); color: #e2d7f2; padding: clamp(44px, 7vw, 84px) 24px; border-bottom: 1px solid rgb(var(--c-line)); }
    .pg-mark { color: color-mix(in srgb, var(--dept) 55%, #fff); }
    .pg-sig-kicker { margin-top: 14px; font-family: var(--font-sans, system-ui); font-size: 11px; font-weight: 800; letter-spacing: .16em; text-transform: uppercase; color: color-mix(in srgb, var(--dept) 45%, #fff); }
    .pg-sig-h { margin: 8px 0 0; font-size: clamp(20px, 3vw, 30px); font-weight: 800; color: #fff; max-width: 22ch; }
    .pg-list { list-style: none; margin: 28px 0 0; padding: 0; }
    .pg-node {
      position: relative; padding: 0 0 22px 30px;
      opacity: 0; transform: translateY(14px);
      animation: pg-in .6s var(--ease-out, ease) forwards; animation-delay: calc(var(--i) * 0.12s + 0.1s);
    }
    .pg-node:not(:last-child)::before { content: ""; position: absolute; left: 5px; top: 14px; bottom: 0; width: 2px; background: rgba(255,255,255,.14); }
    .pg-dot { position: absolute; left: 0; top: 4px; width: 12px; height: 12px; border-radius: 50%; background: var(--dept); box-shadow: 0 0 12px color-mix(in srgb, var(--dept) 70%, transparent); }
    .pg-t { display: block; font-weight: 800; font-size: 16px; color: #fff; }
    .pg-b { display: block; margin-top: 4px; font-size: 13.5px; line-height: 1.6; color: #bda9d8; max-width: 56ch; }
    .pg-sig-note { margin: 8px 0 0; max-width: 58ch; font-size: 14px; line-height: 1.7; color: #a893c7; }
    @keyframes pg-in { to { opacity: 1; transform: none; } }
    @media (prefers-reduced-motion: reduce) { .pg-node { opacity: 1; transform: none; animation: none; } }
  </style>
</Base>
