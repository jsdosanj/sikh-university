---
import Base from '../../layouts/Base.astro';
import '../../styles/departments.css';
import DeptHero from '../../components/departments/DeptHero.astro';
import DeptSections from '../../components/departments/DeptSections.astro';
import { departments } from '../../lib/departments';
const d = departments.find((x) => x.id === 'language-and-literature')!;
const ld = {
  '@context': 'https://schema.org', '@type': 'EducationalOrganization',
  name: `${d.name}, Sikhi University`, description: d.blurb,
  url: 'https://sikhiuni.com/departments/language-and-literature',
  parentOrganization: { '@type': 'CollegeOrUniversity', name: 'Sikhi University', url: 'https://sikhiuni.com/' },
};
const paintee = [
  'ੳ','ਅ','ੲ','ਸ','ਹ','ਕ','ਖ','ਗ','ਘ','ਙ','ਚ','ਛ','ਜ','ਝ','ਞ','ਟ','ਠ','ਡ','ਢ','ਣ',
  'ਤ','ਥ','ਦ','ਧ','ਨ','ਪ','ਫ','ਬ','ਭ','ਮ','ਯ','ਰ','ਲ','ਵ','ੜ',
];
---
<Base title={`${d.name} — Sikhi University`} description={d.blurb} ambient="none">
  <script type="application/ld+json" set:html={JSON.stringify(ld)} slot="head" />
  <div class="dept-page ll-page" style={`--dept:${d.accent}`}>
    <DeptHero d={d}>
      <section class="ll-sig" aria-label="A line of Gurmukhi, written">
        <div class="wrap ll-in">
          <p class="ll-kicker">Gurbāṇī is poetry before it is anything else</p>
          <div class="ll-quill" aria-hidden="true">
            <svg viewBox="0 0 900 220" class="ll-svg">
              <path class="ll-stroke" d="M40 150 C 120 60, 190 60, 250 130 S 360 210, 430 130 C 480 70, 540 70, 590 140 S 700 210, 780 120 C 810 88, 840 92, 860 120"
                    fill="none" stroke="currentColor" stroke-width="6" stroke-linecap="round" pathLength="1" />
              <g class="ll-nib">
                <path d="M0 0 L 26 8 L 6 26 Z" fill="#f4e6c8" />
                <path d="M6 26 L 2 40" stroke="#3a2f1a" stroke-width="3" stroke-linecap="round" />
              </g>
            </svg>
          </div>
          <p class="ll-note">First the script, then the grammar — the lagāṇ-mātrā that carry the meaning — then the registers: Sant Bhāṣā, Braj, Persian. Only then, the literature.</p>
          <div class="ll-grid" lang="pa" role="list" aria-label="Gurmukhi paintee">
            {paintee.map((ch) => <span class="ll-ch" role="listitem" tabindex="0">{ch}</span>)}
          </div>
        </div>
      </section>
    </DeptHero>
    <DeptSections d={d} />
  </div>

  <style>
    .ll-sig {
      --parch: #f6efe0; --ink: #16345e;
      position: relative; overflow: hidden; color: #dfe8f4;
      background:
        radial-gradient(140% 120% at 10% -20%, #17325a, #0e2039 55%, #0a1526),
        var(--parch);
      padding: clamp(3.5rem, 8vw, 6rem) 0; border-bottom: 1px solid rgb(var(--c-line));
    }
    .ll-in { position: relative; z-index: 1; }
    .ll-kicker { font-family: var(--font-sans, system-ui); font-size: 11px; font-weight: 800; letter-spacing: .18em; text-transform: uppercase; color: color-mix(in srgb, var(--dept) 55%, #fff); }

    .ll-quill {
      margin: 26px 0 6px; border-radius: 16px; padding: 18px clamp(1rem, 4vw, 2.5rem);
      background:
        repeating-linear-gradient(0deg, transparent 0 38px, rgba(22,52,94,.12) 38px 39px),
        linear-gradient(180deg, #f8f2e4, #efe6d2);
      box-shadow: inset 0 0 60px rgba(120,90,40,.18), 0 20px 50px rgba(0,0,0,.35);
      color: var(--ink);
    }
    .ll-svg { width: 100%; height: auto; display: block; overflow: visible; }
    .ll-stroke {
      stroke-dasharray: 1; stroke-dashoffset: 1;
      animation: ll-write linear both; animation-timeline: view(); animation-range: entry 8% cover 55%;
    }
    .ll-nib {
      offset-path: path("M40 150 C 120 60, 190 60, 250 130 S 360 210, 430 130 C 480 70, 540 70, 590 140 S 700 210, 780 120 C 810 88, 840 92, 860 120");
      offset-rotate: auto; offset-distance: 0%;
      animation: ll-nib linear both; animation-timeline: view(); animation-range: entry 8% cover 55%;
    }
    @keyframes ll-write { to { stroke-dashoffset: 0; } }
    @keyframes ll-nib { to { offset-distance: 100%; } }
    @supports not (animation-timeline: view()) {
      .ll-stroke { animation: ll-write 2.4s ease-out .3s both; }
      .ll-nib { animation: ll-nib 2.4s ease-out .3s both; }
    }

    .ll-note { margin: 22px 0 0; max-width: 60ch; font-size: 14px; line-height: 1.7; color: #a9bdd6; }
    .ll-grid { display: grid; gap: 8px; margin: 26px 0 0; grid-template-columns: repeat(auto-fill, minmax(44px, 1fr)); }
    @media (min-width: 640px) { .ll-grid { grid-template-columns: repeat(10, 1fr); max-width: 620px; } }
    .ll-ch {
      display: grid; place-items: center; aspect-ratio: 1; border-radius: 8px;
      background: rgba(255,255,255,.05); border: 1px solid rgba(255,255,255,.1);
      font-family: "Noto Serif Gurmukhi", "Noto Sans Gurmukhi", serif; font-size: 22px; color: #cfe0f5;
      transition: transform .18s var(--ease-spring, ease), background .18s, color .18s, border-color .18s;
    }
    .ll-ch:hover, .ll-ch:focus-visible { transform: scale(1.18); background: color-mix(in srgb, var(--dept) 30%, transparent); border-color: var(--dept); color: #fff; outline: none; }
    @media (prefers-reduced-motion: reduce) {
      .ll-stroke { stroke-dashoffset: 0; animation: none; }
      .ll-nib { offset-distance: 100%; animation: none; }
      .ll-ch:hover, .ll-ch:focus-visible { transform: none; }
    }
  </style>
</Base>
