---
import Base from '../../layouts/Base.astro';
import '../../styles/departments.css';
import DeptHero from '../../components/departments/DeptHero.astro';
import DeptSections from '../../components/departments/DeptSections.astro';
import { departments } from '../../lib/departments';
const d = departments.find((x) => x.id === 'health')!;
const ld = {
  '@context': 'https://schema.org', '@type': 'EducationalOrganization',
  name: `${d.name}, Sikhi University`, description: d.blurb,
  url: 'https://sikhiuni.com/departments/health',
  parentOrganization: { '@type': 'CollegeOrUniversity', name: 'Sikhi University', url: 'https://sikhiuni.com/' },
};
---
<Base title={`${d.name} — Sikhi University`} description={d.blurb} ambient="none">
  <script type="application/ld+json" set:html={JSON.stringify(ld)} slot="head" />
  <div class="dept-page" style={`--dept:${d.accent}`}>
    <DeptHero d={d}>
      <section class="he-sig" aria-label="A breathing exercise">
        <div class="wrap he-in">
          <div class="he-breath" aria-hidden="true">
            <span class="he-ring"></span><span class="he-ring"></span><span class="he-core"></span>
            <span class="he-label">breathe with the circle</span>
          </div>
          <div class="he-copy">
            <p class="he-kicker">ਸਾਸਿ ਸਾਸਿ &mdash; with every breath</p>
            <h2 class="he-h">The body is a vessel, and caring for it is seva</h2>
            <p class="he-note">
              This department covers physical and mental health with Sikh framing and without stigma
              &mdash; grief and bhāṇā, trauma and recovery, raising children in the faith, and the quiet
              discipline of growing your own food. Follow the circle for four counts in, four counts out.
            </p>
          </div>
        </div>
      </section>
    </DeptHero>
    <DeptSections d={d} />
  </div>

  <style>
    .he-sig { background: linear-gradient(180deg, #0e2418, #0a1a11); color: #d7ecdf; padding: clamp(48px, 8vw, 96px) 24px; border-bottom: 1px solid rgb(var(--c-line)); }
    .he-in { display: grid; gap: 34px; align-items: center; }
    @media (min-width: 820px) { .he-in { grid-template-columns: 240px 1fr; gap: 48px; } }
    .he-breath { position: relative; width: 200px; height: 200px; margin: 0 auto; display: grid; place-items: center; }
    .he-core { position: absolute; width: 64px; height: 64px; border-radius: 50%; background: var(--dept); box-shadow: 0 0 40px color-mix(in srgb, var(--dept) 70%, transparent); animation: he-breathe 8s ease-in-out infinite; }
    .he-ring { position: absolute; width: 200px; height: 200px; border-radius: 50%; border: 1px solid color-mix(in srgb, var(--dept) 45%, transparent); animation: he-breathe 8s ease-in-out infinite; }
    .he-ring:nth-child(2) { width: 140px; height: 140px; animation-delay: -0.4s; opacity: .7; }
    .he-label { position: relative; z-index: 1; font-family: var(--font-sans, system-ui); font-size: 10.5px; letter-spacing: .12em; text-transform: uppercase; color: #eafff2; text-align: center; max-width: 90px; line-height: 1.4; }
    @keyframes he-breathe { 0%,100% { transform: scale(.62); } 45%,55% { transform: scale(1); } }
    .he-kicker { font-family: "Noto Serif Gurmukhi", serif; font-size: 15px; color: color-mix(in srgb, var(--dept) 40%, #fff); }
    .he-h { margin: 8px 0 0; font-size: clamp(20px, 3vw, 30px); font-weight: 800; color: #fff; max-width: 22ch; }
    .he-note { margin: 16px 0 0; max-width: 58ch; font-size: 14.5px; line-height: 1.72; color: #a9cdb6; }
    @media (prefers-reduced-motion: reduce) {
      .he-core, .he-ring { animation: none; }
      .he-core { transform: scale(.85); }
    }
  </style>
</Base>
