---
import Base from '../../layouts/Base.astro';
import '../../styles/departments.css';
import DeptHero from '../../components/departments/DeptHero.astro';
import DeptSections from '../../components/departments/DeptSections.astro';
import { departments } from '../../lib/departments';
const d = departments.find((x) => x.id === 'the-arts')!;
const ld = {
  '@context': 'https://schema.org', '@type': 'EducationalOrganization',
  name: `${d.name}, Sikhi University`, description: d.blurb,
  url: 'https://sikhiuni.com/departments/the-arts',
  parentOrganization: { '@type': 'CollegeOrUniversity', name: 'Sikhi University', url: 'https://sikhiuni.com/' },
};
// A selection of the raags of Sri Guru Granth Sahib Ji, with the mood each carries.
const raags = [
  ['Sirī', 'contentment, detachment'], ['Mājh', 'longing, separation'], ['Gaüṛī', 'reflection, seriousness'],
  ['Āsā', 'hope, striving'], ['Gūjrī', 'quiet devotion'], ['Devgandhārī', 'stillness'],
  ['Bihāgṛā', 'the ache of union'], ['Vaḍahans', 'grief, and its acceptance'], ['Sorṭh', 'praise'],
  ['Dhanāsrī', 'inspiration to act'], ['Jaitsrī', 'humility'], ['Ṭoḍī', 'the pull away from the world'],
  ['Tilaṅg', 'a plea'], ['Sūhī', 'joy, the bride'], ['Bilāval', 'happiness, ease'],
  ['Rāmkalī', 'discipline, yoga'], ['Māru', 'courage, the battlefield'], ['Tukhārī', 'the seasons turning'],
  ['Kedārā', 'devotion at dusk'], ['Bhairaü', 'awe, the fierce'], ['Basant', 'renewal, spring'],
  ['Sāraṅg', 'the thirst of noon'], ['Malār', 'the rains, and mercy'], ['Kānṛā', 'steady love'],
  ['Kalyāṇ', 'evening serenity'], ['Prabhātī', 'the first light'], ['Jaijāvantī', 'acceptance, letting go'],
];
---
<Base title={`${d.name} — Sikhi University`} description={d.blurb} ambient="none">
  <script type="application/ld+json" set:html={JSON.stringify(ld)} slot="head" />
  <div class="dept-page" style={`--dept:${d.accent}`}>
    <DeptHero d={d}>
      <section class="ar-sig" aria-label="The raags of Sri Guru Granth Sahib Ji">
        <div class="wrap">
          <p class="ar-sig-kicker">Srī Guru Granth Sāhib Jī is organised by rāg — over thirty of them</p>
          <h2 class="ar-sig-h">Each rāg carries a feeling. Kīrtan holds the Shabad in it.</h2>
          <div class="ar-wave" aria-hidden="true">
            <svg viewBox="0 0 1200 60" preserveAspectRatio="none"><path d="M0 30 Q 60 0 120 30 T 240 30 T 360 30 T 480 30 T 600 30 T 720 30 T 840 30 T 960 30 T 1080 30 T 1200 30" fill="none" stroke="currentColor" stroke-width="2"/></svg>
          </div>
          <div class="ar-raags" role="list">
            {raags.map(([name, mood]) => (
              <span class="ar-raag" role="listitem" tabindex="0">
                <span class="ar-name">{name}</span>
                <span class="ar-mood">{mood}</span>
              </span>
            ))}
          </div>
          <p class="ar-sig-note">The department teaches the rāg and tāl, the tantī sāj the Gurus played, and the visual tradition alongside it — the frescoes, the illuminated biṛs, the architecture.</p>
        </div>
      </section>
    </DeptHero>
    <DeptSections d={d} />
  </div>

  <style>
    .ar-sig { background: linear-gradient(180deg, #2a120e, #1c0c09); color: #f0d9d2; padding: clamp(44px, 7vw, 84px) 24px; border-bottom: 1px solid rgb(var(--c-line)); }
    .ar-sig-kicker { font-family: var(--font-sans, system-ui); font-size: 11px; font-weight: 800; letter-spacing: .16em; text-transform: uppercase; color: color-mix(in srgb, var(--dept) 45%, #fff); }
    .ar-sig-h { margin: 8px 0 0; font-size: clamp(20px, 3vw, 30px); font-weight: 800; color: #fff; max-width: 28ch; }
    .ar-wave { color: color-mix(in srgb, var(--dept) 55%, #fff); margin: 22px 0 6px; height: 46px; opacity: .55; }
    .ar-wave svg { width: 100%; height: 100%; }
    .ar-wave path { stroke-dasharray: 6 10; animation: ar-flow 3s linear infinite; }
    @keyframes ar-flow { to { stroke-dashoffset: -160; } }
    .ar-raags { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 18px; }
    .ar-raag {
      position: relative; display: inline-flex; align-items: center;
      padding: 8px 14px; border-radius: 999px;
      background: rgba(255,255,255,.05); border: 1px solid rgba(255,255,255,.12);
      font-family: var(--font-sans, system-ui); font-size: 13px; color: #e8cdc5;
      cursor: default; transition: background .18s, border-color .18s, color .18s;
    }
    .ar-raag:hover, .ar-raag:focus-visible { background: color-mix(in srgb, var(--dept) 28%, transparent); border-color: var(--dept); color: #fff; outline: none; }
    .ar-mood {
      position: absolute; left: 50%; bottom: calc(100% + 8px); transform: translateX(-50%) translateY(4px);
      white-space: nowrap; padding: 5px 10px; border-radius: 8px;
      background: #201; border: 1px solid var(--dept); color: #fff; font-size: 11.5px;
      opacity: 0; pointer-events: none; transition: opacity .16s, transform .16s;
    }
    .ar-raag:hover .ar-mood, .ar-raag:focus-visible .ar-mood { opacity: 1; transform: translateX(-50%) translateY(0); }
    .ar-sig-note { margin: 24px 0 0; max-width: 62ch; font-size: 14px; line-height: 1.7; color: #cbaaa1; }
    @media (prefers-reduced-motion: reduce) { .ar-wave path { animation: none; } }
  </style>
</Base>
