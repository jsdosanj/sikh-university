---
import Base from '../../layouts/Base.astro';
import '../../styles/departments.css';
import DeptHero from '../../components/departments/DeptHero.astro';
import DeptSections from '../../components/departments/DeptSections.astro';
import { departments } from '../../lib/departments';
const d = departments.find((x) => x.id === 'theology')!;
const ld = {
  '@context': 'https://schema.org', '@type': 'EducationalOrganization',
  name: `${d.name}, Sikhi University`, description: d.blurb,
  url: 'https://sikhiuni.com/departments/theology',
  parentOrganization: { '@type': 'CollegeOrUniversity', name: 'Sikhi University', url: 'https://sikhiuni.com/' },
};
const mool = [
  'ੴ', 'ਸਤਿ ਨਾਮੁ', 'ਕਰਤਾ ਪੁਰਖੁ', 'ਨਿਰਭਉ', 'ਨਿਰਵੈਰੁ',
  'ਅਕਾਲ ਮੂਰਤਿ', 'ਅਜੂਨੀ', 'ਸੈਭੰ', 'ਗੁਰ ਪ੍ਰਸਾਦਿ ॥',
];
---
<Base title={`${d.name} — Sikhi University`} description={d.blurb} ambient="none">
  <script type="application/ld+json" set:html={JSON.stringify(ld)} slot="head" />
  <div class="dept-page" style={`--dept:${d.accent}`}>
    <DeptHero d={d}>
      <section class="the-sig dept-grain" aria-label="The Mool Mantar">
        <div class="wrap">
          <p class="the-sig-kicker">Everything in this department begins with one verse</p>
          <p class="the-sig-mool" lang="pa">
            {mool.map((w) => <span>{w}</span>)}
          </p>
          <p class="the-sig-note">The Mūl Mantar — the opening of Srī Guru Granth Sāhib Jī, Aṅg 1. The theology, the metaphysics, the ethics of the whole tradition unfold from these words.</p>
        </div>
      </section>
    </DeptHero>
    <DeptSections d={d} />
  </div>

  <style>
    .the-sig {
      position: relative; overflow: hidden;
      background: radial-gradient(120% 90% at 20% 0%, #2a1d05, #140d02 60%, #0f0a02);
      color: #f4e6c8; padding: clamp(48px, 8vw, 96px) 24px;
      border-bottom: 1px solid rgb(var(--c-line));
    }
    .the-sig::before {
      content: ""; position: absolute; inset: 0; opacity: .5;
      background: radial-gradient(40% 60% at 20% 30%, color-mix(in srgb, var(--dept) 55%, transparent), transparent 70%);
      animation: the-glow 14s ease-in-out infinite alternate;
    }
    @keyframes the-glow { from { transform: translate(-6%, -4%) scale(1); } to { transform: translate(8%, 6%) scale(1.15); } }
    .the-sig .wrap { position: relative; z-index: 1; }
    .the-sig-kicker { font-family: var(--font-sans, system-ui); font-size: 11px; font-weight: 800; letter-spacing: .18em; text-transform: uppercase; color: color-mix(in srgb, var(--dept) 45%, #fff); }
    .the-sig-mool {
      display: flex; flex-wrap: wrap; gap: 10px 26px; margin: 22px 0 0;
      font-family: "Noto Serif Gurmukhi", "Noto Sans Gurmukhi", serif;
      font-size: clamp(22px, 3.4vw, 40px); line-height: 1.5; color: #ffdf9e;
      text-shadow: 0 0 30px color-mix(in srgb, var(--dept) 60%, transparent);
    }
    .the-sig-mool span { opacity: 0; transform: translateY(10px); animation: the-word .7s var(--ease-out, ease) forwards; }
    .the-sig-mool span:nth-child(1){animation-delay:.05s} .the-sig-mool span:nth-child(2){animation-delay:.18s}
    .the-sig-mool span:nth-child(3){animation-delay:.31s} .the-sig-mool span:nth-child(4){animation-delay:.44s}
    .the-sig-mool span:nth-child(5){animation-delay:.57s} .the-sig-mool span:nth-child(6){animation-delay:.70s}
    .the-sig-mool span:nth-child(7){animation-delay:.83s} .the-sig-mool span:nth-child(8){animation-delay:.96s}
    .the-sig-mool span:nth-child(9){animation-delay:1.09s}
    @keyframes the-word { to { opacity: 1; transform: none; } }
    .the-sig-note { margin: 26px 0 0; max-width: 58ch; font-size: 14.5px; line-height: 1.7; color: #c9b487; }
    @media (prefers-reduced-motion: reduce) {
      .the-sig::before { animation: none; }
      .the-sig-mool span { opacity: 1; transform: none; animation: none; }
    }
  </style>
</Base>
