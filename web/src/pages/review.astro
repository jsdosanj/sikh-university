---
import Base from '../layouts/Base.astro';
---
<Base title="Review — Sikhi University" description="Scholar review queue for submitted courses." ambient="hall" noindex={true}>
  <section class="wrap max-w-4xl py-12">
    <h1 class="text-3xl font-bold text-white">Review queue</h1>
    <p class="mt-2 text-white/85">Submitted courses awaiting scholar/admin review before they can be merged into the live catalogue.</p>
    <div id="app" class="mt-8"><p class="text-white/70">Loading…</p></div>
  </section>
  <script>
    const esc = (s: unknown) => String(s == null ? '' : s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c] as string));
    const app = document.getElementById('app')!;
    const api = (p: string, o?: RequestInit) => fetch(p, { credentials: 'same-origin', headers: { 'content-type': 'application/json' }, ...(o || {}) })
      .then((r) => r.json().then((d) => ({ ok: r.ok, d })));

    const CHECKLIST = [
      'Key concepts and technical terms are in Punjabi Unicode (no transliteration)',
      'At least four ਸ਼ਬਦ from Sri Guru Granth Sahib Ji, in Gurmukhi with a faithful English translation',
      'Citations follow Chicago Manual of Style',
      'Gurbani references cite the ਅੰਗ — no invented Gurbani phrases',
      'Table of contents and Works Cited are present',
      'AI-assisted content is honestly declared and will render "Created by AI"',
    ];

    async function renderQueue() {
      const { ok, d } = await api('/api/review/queue');
      if (!ok) { app.innerHTML = '<p class="text-white/70">You need reviewer access (a reviewer flag, or admin) to see this queue.</p>'; return; }
      const drafts = d.drafts || [];
      app.innerHTML = drafts.length ? `<div class="grid gap-3">${drafts.map((dr: any) => `
        <a href="#" data-open="${esc(dr.id)}" class="glass-lite block p-4 hover:-translate-y-0.5 transition">
          <div class="flex items-center gap-2"><span class="font-bold text-navy">${esc(dr.title)}</span><span class="pill bg-surface text-navy">${esc(dr.status)}</span>${dr.topic !== 'modern-skills' ? '<span class="pill bg-saffron-soft text-saffron-deep">Sikhi topic — scholar review required</span>' : ''}</div>
          <div class="mt-1 font-sans text-xs text-muted">by ${esc(dr.author_name || dr.author_email)} · ${esc(dr.topic)} · level ${esc(dr.level)}</div>
        </a>`).join('')}</div>` : '<p class="text-white/70">Nothing waiting for review.</p>';
      document.querySelectorAll('[data-open]').forEach((a) => a.addEventListener('click', (e) => { e.preventDefault(); renderDraft((a as HTMLElement).dataset.open!); }));
    }

    async function renderDraft(id: string) {
      const { ok, d } = await api('/api/review/draft?id=' + encodeURIComponent(id));
      if (!ok) { (window as any).suToast(d.error || 'Could not load draft.', 'error'); return; }
      const { draft, lessons, quiz } = d;
      let meta: any = {}; try { meta = JSON.parse(draft.meta); } catch (e) {}

      app.innerHTML = `
        <button id="back" class="font-sans text-sm text-white/80 underline">&larr; Queue</button>
        <div class="glass-strong mt-4 rounded-xl2 p-6">
          <h2 class="text-2xl font-bold text-navy">${esc(draft.title)}</h2>
          <p class="mt-1 font-sans text-xs text-muted">${esc(draft.course_id)} · ${esc(draft.topic)} · level ${esc(draft.level)} · ${meta.aiAssisted ? 'Created with AI assistance' : 'No AI assistance declared'}</p>
          <p class="mt-3">${esc(meta.summary || '')}</p>

          <h3 class="mt-6 text-lg font-bold">Lessons (${lessons.length})</h3>
          ${lessons.map((ls: any) => `<div class="mt-3 rounded-xl2 border border-line bg-surface p-4"><div class="font-bold text-navy">${esc(ls.title)}</div><div class="lesson-prose mt-2 max-w-[68ch]">${ls.html}</div></div>`).join('')}

          <h3 class="mt-6 text-lg font-bold">Quiz (${quiz.length})</h3>
          ${quiz.map((q: any) => { const options = JSON.parse(q.options || '[]'); return `<div class="mt-2 rounded-xl2 border border-line bg-surface p-3"><div class="font-semibold">${esc(q.q)}</div><ul class="mt-1 list-disc pl-5 text-sm">${options.map((o: string, i: number) => `<li class="${i === q.answer ? 'font-bold text-ok' : ''}">${esc(o)}${i === q.answer ? ' (correct)' : ''}</li>`).join('')}</ul></div>`; }).join('')}

          <h3 class="mt-8 text-lg font-bold">CLAUDE.md content standards checklist</h3>
          <ul class="mt-2 list-disc pl-5 text-sm text-muted">${CHECKLIST.map((c) => `<li>${esc(c)}</li>`).join('')}</ul>

          <div class="mt-6 rounded-xl2 border-t border-line pt-4">
            <label class="block font-sans text-sm font-semibold">Notes (shared with the author)<textarea id="notes" rows="3" class="mt-1 w-full rounded-xl border border-line bg-surface px-3 py-2 font-sans"></textarea></label>
            <div class="mt-3 flex gap-2">
              <button id="approve" class="btn btn-primary">Approve</button>
              <button id="changes" class="btn">Request changes</button>
            </div>
          </div>
        </div>`;

      document.getElementById('back')!.addEventListener('click', renderQueue);
      const decide = (decision: string) => async () => {
        const notes = (document.getElementById('notes') as HTMLTextAreaElement).value;
        const r = await api('/api/review/decision', { method: 'POST', body: JSON.stringify({ id, decision, notes }) });
        if (r.ok) { (window as any).suToast('Decision recorded.', 'ok'); renderQueue(); } else (window as any).suToast(r.d.error || 'Could not record decision.', 'error');
      };
      document.getElementById('approve')!.addEventListener('click', decide('approve'));
      document.getElementById('changes')!.addEventListener('click', decide('changes_requested'));
    }

    renderQueue();
  </script>
</Base>
