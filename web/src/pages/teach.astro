---
import Base from '../layouts/Base.astro';
---
<Base title="Teach at Sikhi University" description="Apply to author and maintain courses at Sikhi University." ambient="hall">
  <section class="wrap max-w-2xl py-14">
    <p class="eyebrow text-saffron">Teach</p>
    <h1 class="mt-2 text-3xl font-bold text-white" data-i18n="teach.h1">Teach at Sikhi University</h1>
    <div id="teach" class="glass-strong mt-6 p-6"><p class="text-muted" data-i18n="teach.loading">Loading…</p></div>
  </section>
  <script>
    const root = document.getElementById('teach');
    fetch('/api/me', { credentials: 'same-origin' }).then((r) => (r.ok ? r.json() : { user: null })).then(({ user: u }) => {
      if (!u) { root.innerHTML = '<div class="mt-4 rounded-xl border-l-4 border-saffron bg-surface p-4"><span data-i18n="teach.please">Please</span> <a class="underline" href="/login" data-i18n="teach.signinlink">sign in</a> <span data-i18n="teach.signin.suffix1">first, then apply to teach.</span></div>'; return; }
      if (u.role === 'teacher' || u.role === 'admin') { root.innerHTML = `<div class="mt-4 rounded-xl border-l-4 border-ok bg-surface p-4"><span data-i18n="teach.approved.prefix">You're an approved</span> <strong>${u.role}</strong>. <span data-i18n="teach.approved.suffix">Course-authoring tools are coming next.</span></div>`; return; }
      root.innerHTML = `
        <p class="mt-2 text-lg text-muted" data-i18n="teach.intro">Are you a scholar or knowledgeable teacher? Apply to author and maintain courses. Each application is reviewed by an admin.</p>
        <form id="ap" class="mt-6 space-y-4">
          <label class="block font-sans text-sm font-semibold"><span data-i18n="teach.label.bg">Your background</span><textarea id="bg" rows="6" required placeholder="Your background, qualifications, and area(s) of expertise." data-i18n-ph="teach.ph.bg" class="mt-1 w-full rounded-xl border border-line bg-surface px-4 py-2.5 font-sans"></textarea></label>
          <label class="block font-sans text-sm font-semibold"><span data-i18n="teach.label.courses">Courses you'd like to teach</span><textarea id="co" rows="3" placeholder="What course(s) would you like to teach?" data-i18n-ph="teach.ph.courses" class="mt-1 w-full rounded-xl border border-line bg-surface px-4 py-2.5 font-sans"></textarea></label>
          <button id="sub" type="submit" class="btn btn-primary" data-i18n="teach.submit">Submit application</button>
        </form><div id="out" class="mt-4"></div>`;
      const form = document.getElementById('ap'); const out = document.getElementById('out'); const btn = document.getElementById('sub');
      form.addEventListener('submit', (ev) => {
        ev.preventDefault(); const bg = document.getElementById('bg').value.trim(); if (!bg) return;
        btn.disabled = true;
        fetch('/api/teacher/apply', { method: 'POST', credentials: 'same-origin', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ background: bg, courses: document.getElementById('co').value }) })
          .then((r) => r.json().then((d) => ({ ok: r.ok, d }))).then(({ ok, d }) => {
            if (ok) form.outerHTML = `<div class="rounded-xl border-l-4 border-ok bg-surface p-4"><strong data-i18n="teach.submitted.title">Application submitted.</strong> <span data-i18n="teach.submitted.body">An admin will review it and you'll be notified by email.</span></div>`;
            else { btn.disabled = false; out.innerHTML = `<div class="rounded-xl border-l-4 border-saffron bg-surface p-3 font-sans text-sm">${(d && d.error) || 'Error'}</div>`; }
          }).catch(() => { btn.disabled = false; });
      });
    }).catch(() => { root.innerHTML = '<div class="mt-4 rounded-xl border-l-4 border-saffron bg-surface p-4"><span data-i18n="teach.please">Please</span> <a class="underline" href="/login" data-i18n="teach.signinlink">sign in</a> <span data-i18n="teach.signin.suffix2">first.</span></div>'; });
  </script>
</Base>
