---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import Icon from '../components/Icon.astro';
import { topics, published, paths, TOPIC_ICONS } from '../lib/data';
const SITE = 'https://sikhiuni.com';
const ld = {
  '@context': 'https://schema.org', '@type': 'CollegeOrUniversity',
  '@id': SITE + '/#org', // merges with the Organization node Base.astro emits site-wide
  name: 'Sikhi University', url: SITE + '/', description: 'A free, open online university for Sikhi and modern skills.', logo: SITE + '/assets/icon-512.png', image: SITE + '/assets/og-image.png',
  sameAs: ['https://sikharchive.net'],
};
// WebSite (with the sitelinks SearchAction) is now emitted site-wide by Base.astro.
---
<Base title="Sikhi University — free, open Sikhi & modern-skills courses">
  <script type="application/ld+json" set:html={JSON.stringify(ld)} slot="head" />

  <!-- Hero -->
  <header class="relative overflow-hidden bg-gradient-to-br from-brand via-brand-strong to-navy-deep text-white">
    <div class="wrap relative grid items-center gap-12 py-20 lg:grid-cols-[minmax(0,1fr)_auto]">
      <div>
        <p class="font-sans text-sm uppercase tracking-[0.2em] text-saffron" data-i18n="home.eyebrow">Free · Open · Worldwide</p>
        <h1 class="mt-3 max-w-3xl text-4xl font-bold leading-tight text-white sm:text-5xl">Dive into the depths of <span class="text-saffron">Sikhi</span>.</h1>
        <p class="mt-5 max-w-2xl text-lg text-white/85" data-i18n="home.herosub">A free, open university anyone, anywhere can attend. Start at the surface and keep going — Sikh history, theology, philosophy, language, music and the arts, taught from authentic sources. The deeper you go, the more there is.</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a class="btn btn-primary" href="/catalog" data-i18n="home.cta.browse">Browse courses</a>
          <a class="btn btn-ghost" href="https://sikharchive.net" target="_blank" rel="noopener noreferrer" data-i18n="home.cta.archive">Visit Sikh Archive →</a>
        </div>
        <div class="mt-12 flex flex-wrap gap-x-12 gap-y-4">
          {[[published.length + '+', 'courses'], [topics.length, 'subjects'], ['100%', 'free'], ['Open', 'to all, worldwide']].map((s) => (
            <div><div class="text-3xl font-bold text-saffron">{s[0]}</div><div class="font-sans text-sm text-white/70">{s[1]}</div></div>
          ))}
        </div>
      </div>
      <div class="hidden justify-self-center lg:block">
        <Logo class="h-72 w-72 text-saffron/90 drop-shadow-[0_8px_40px_rgba(244,178,26,0.35)] xl:h-[22rem] xl:w-[22rem]" />
      </div>
    </div>
  </header>

  <!-- Continue-learning resume card (E5): shown only if the visitor has a course in
       progress. Reads localStorage (no network for the anonymous case); resolves the
       title from the slim index. Hidden by default so it never flashes empty. -->
  <div id="su-resume" hidden class="wrap pt-6">
    <a id="su-resume-link" href="#" class="flex items-center justify-between gap-4 rounded-xl2 border border-saffron bg-saffron-soft px-5 py-4 transition hover:-translate-y-0.5 hover:shadow-lift">
      <span>
        <span class="block font-sans text-xs font-bold uppercase tracking-wider text-saffron-deep">Continue learning</span>
        <span id="su-resume-title" class="block font-serif text-lg font-bold text-navy"></span>
      </span>
      <span class="shrink-0 font-sans text-sm font-semibold text-navy">Resume &rarr;</span>
    </a>
  </div>
  <script>
    (function () {
      var get = function (k, d) { try { var v = localStorage.getItem(k); return v === null ? d : JSON.parse(v); } catch (e) { return d; } };
      // Prefer the explicit last-opened course; else the in-progress course with the
      // most completed lessons.
      var id = get('last_course', null);
      if (!id) {
        var best = null, bestN = 0;
        for (var i = 0; i < localStorage.length; i++) {
          var key = localStorage.key(i); if (key.indexOf('done_') !== 0) continue;
          var d = get(key, {}); var n = 0; for (var k in d) if (d[k]) n++;
          if (n > bestN) { bestN = n; best = key.slice(5); }
        }
        id = best;
      }
      if (!id) return;
      fetch('/data/index.json').then(function (r) { return r.json(); }).then(function (data) {
        var c = (data.courses || []).find(function (x) { return x.id === id; });
        if (!c) return;
        document.getElementById('su-resume-title').textContent = c.title;
        document.getElementById('su-resume-link').href = '/course/' + id;
        document.getElementById('su-resume').hidden = false;
      }).catch(function () {});
    })();
  </script>

  <!-- Mission -->
  <section class="bg-gradient-to-b from-navy-deep to-brand text-white">
    <div class="wrap py-16">
      <p class="text-center font-sans text-sm uppercase tracking-[0.2em] text-saffron" data-i18n="home.mission.eyebrow">Our mission</p>
      <h2 class="mx-auto mt-3 max-w-4xl xl:max-w-5xl text-center text-2xl font-bold text-white sm:text-3xl" data-i18n="home.mission.heading">From the wisdom of our ancestors to a living bond with Waheguru</h2>
      <p class="mx-auto mt-4 max-w-4xl xl:max-w-5xl text-center text-lg text-white/90">We learn from those who came before us — the Gurus, the scholars, the saints and the soldiers — and carry their light forward. We begin with the basics of Sikhi and keep going into its depths, until one truth becomes unmistakable: that <strong>Sri Guru Granth Sahib Ji</strong> is the living Guru and the one universal Truth. And the real aim of all of it is simple — to build an intimate, personal relationship with <strong>Waheguru</strong>.</p>
      <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {[
          ['diya', 'Learn from our ancestors', 'The Gurus, scholars, saints and soldiers whose lives and writings light the way — taught from authentic sources.'],
          ['waves', 'From the basics to the depths', 'Start with the simplest questions and follow them as far as you dare. The deeper you go, the more there is.'],
          ['book', 'Sri Guru Granth Sahib Ji', 'The living Guru and the universal Truth. Every path here leads back to the Shabad — read it for yourself in our reader.'],
          ['lotus', 'A relationship with Waheguru', 'Not just knowledge, but Naam, Simran and seva — a living, personal bond with the Divine.'],
        ].map((m) => (
          <div class="rounded-xl2 bg-white/10 p-5 backdrop-blur">
            <Icon name={m[0]} class="h-8 w-8 text-saffron" />
            <h3 class="mt-2 text-lg font-bold text-white">{m[1]}</h3>
            <p class="mt-1 text-[0.95rem] text-white/80">{m[2]}</p>
          </div>
        ))}
      </div>
      <div class="mt-10 flex flex-wrap justify-center gap-3">
        <a class="btn btn-primary" href="/santhiya?src=sggs">Read Sri Guru Granth Sahib Ji</a>
        <a class="btn btn-ghost" href="/catalog#paths">Start a learning path</a>
        <a class="btn btn-ghost" href="/about">Why we built this</a>
      </div>
    </div>
    <div aria-hidden="true" class="pointer-events-none -mt-px -mb-px h-32 bg-gradient-to-b from-brand to-paper"></div>
  </section>

  <!-- First of its kind -->
  <section class="wrap py-16">
    <div class="mx-auto max-w-4xl xl:max-w-5xl text-center">
      <p class="font-sans text-sm uppercase tracking-[0.2em] text-saffron-deep">First of its kind</p>
      <h2 class="mt-3 text-3xl font-bold sm:text-4xl">Nothing like this has ever existed<br class="hidden sm:block" /> for Sikhi.</h2>
      <p class="mt-4 text-lg text-muted">For generations, serious study of Sikhi required access to rare books, a living scholar, or years of searching. Sikhi University changes that — permanently. Every course, every seminar, every lesson is here, free, for anyone on Earth.</p>
    </div>

    <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {[
        {
          icon: 'ruler',
          title: 'A complete academic ladder',
          body: '100-level introductions to 500-level graduate seminars — the only Sikh learning platform with a full university-style curriculum, from your first question to doctoral depth.',
        },
        {
          icon: 'pillar',
          title: 'Scholar-attributed courses',
          body: 'Every course is taught by a named scholar — Prof. Sahib Singh, Kavi Santokh Singh, Bhai Randhir Singh, Bhai Kahn Singh Nabha, Bhai Vir Singh and more — grounding each lesson in authentic, authoritative scholarship.',
        },
        {
          icon: 'globe',
          title: 'Open to the whole world',
          body: 'No fees. No visa. No Gurdwara nearby required. A Sikh in Kenya, Canada, Chile, or Australia gets the same world-class education as one sitting in Amritsar.',
        },
        {
          icon: 'books',
          title: `${published.length}+ courses across 23 subjects`,
          body: 'Theology, philosophy, history, language, music, the arts, economics, science, health, parenting — Sikhi touches every dimension of life, and we cover all of it.',
        },
        {
          icon: 'microscope',
          title: 'Graduate seminars that go all the way',
          body: 'Sikh hermeneutics. Manuscript paleography. Gurmat metaphysics. Comparative mysticism. For students who refuse to stop at the surface — we go as deep as there is to go.',
        },
        {
          icon: 'lotus',
          title: 'Rooted in authentic sources',
          body: 'Every course draws from the Sri Guru Granth Sahib Ji, authenticated scholarly works, and the SikhLibrary dataset — not Wikipedia summaries or secondhand summaries.',
        },
      ].map((f) => (
        <div class="rounded-xl2 border border-line bg-surface p-6 shadow-card">
          <Icon name={f.icon} class="h-8 w-8 text-saffron-deep" />
          <h3 class="mt-3 text-lg font-bold text-navy">{f.title}</h3>
          <p class="mt-2 text-[0.95rem] text-muted leading-relaxed">{f.body}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Built for current and future generations -->
  <section class="bg-gradient-to-br from-navy-strong to-brand text-white">
    <div class="wrap py-16">
      <div class="mx-auto max-w-5xl xl:max-w-6xl">
        <div class="grid gap-10 lg:grid-cols-2 items-center">
          <div>
            <p class="font-sans text-sm uppercase tracking-[0.2em] text-saffron">For every generation</p>
            <h2 class="mt-3 text-3xl font-bold text-white sm:text-4xl">Built for Sikhs of today<br />and tomorrow.</h2>
            <p class="mt-4 text-lg text-white/85 leading-relaxed">The Sikh diaspora spans every continent. Our children grow up in Toronto, London, Nairobi, Sydney, and São Paulo. They have questions that deserve real answers — not surface-level summaries, but deep, honest, scholarly engagement with Sikhi.</p>
            <p class="mt-4 text-white/80 leading-relaxed">Sikhi University was built so that the next generation never has to choose between their heritage and their intellectual rigour. They can have both. They deserve both.</p>
            <div class="mt-8 flex flex-wrap gap-3">
              <a class="btn btn-primary" href="/catalog">Start learning free</a>
              <a class="btn btn-ghost" href="/about">Our story →</a>
            </div>
          </div>
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            {[
              ['sprout', '100-level', 'Complete beginners — no background needed'],
              ['book', '200–300 level', 'Growing students ready to go deeper'],
              ['microscope', '400-level', 'Advanced learners in serious study'],
              ['cap', '500-level', 'Graduate seminars for scholars'],
              ['pen', 'Languages change', 'Gurbani was written in Punjabi, Braj Bhasha, Sant Bhasha, and Persian. Every course here bridges the Guru\'s depth to the language you live in today.'],
              ['diya', 'ਸਿੱਖ means learner', 'Gurbani\'s call to forever seek is written into our name. This university exists to honour that call — for every generation, everywhere on Earth.'],
            ].map((t) => (
              <div class="rounded-xl2 bg-white/10 p-4 backdrop-blur">
                <Icon name={t[0]} class="h-7 w-7 text-saffron" />
                <div class="mt-2 font-bold text-white text-sm">{t[1]}</div>
                <div class="mt-1 text-xs text-white/70">{t[2]}</div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Proof points / differentiators -->
  <section class="border-y border-line bg-surface">
    <div class="wrap py-12">
      <div class="grid gap-6 text-center sm:grid-cols-2 lg:grid-cols-4">
        {[
          [published.length + '+', 'Courses published'],
          ['23', 'Academic subjects'],
          ['100–500', 'Course levels'],
          ['100%', 'Free, forever'],
        ].map((s) => (
          <div class="rounded-xl2 border border-line bg-paper p-6">
            <div class="text-4xl font-bold text-navy">{s[0]}</div>
            <div class="mt-1 font-sans text-sm text-muted">{s[1]}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Call to action -->
  <section class="wrap py-16 text-center">
    <h2 class="text-3xl font-bold sm:text-4xl" data-i18n="home.cta2.heading">Start your journey today.</h2>
    <p class="mx-auto mt-4 max-w-xl text-lg text-muted" data-i18n="home.cta2.sub">It takes thirty seconds to begin. No sign-up required. Pick a course, start a lesson — and see how deep Sikhi really goes.</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a class="btn btn-primary" href="/catalog" data-i18n="home.cta2.browseall">Browse all courses</a>
      <a class="btn" href="/catalog#paths" data-i18n="home.cta2.path">Follow a learning path</a>
      <a class="btn" href="/santhiya?src=sggs" data-i18n="home.cta2.read">Read the Guru Granth Sahib Ji</a>
    </div>
  </section>

</Base>
