---
import Base from '../layouts/Base.astro';
---
<Base title="Course Studio — Sikhi University" description="Draft, validate, and submit a course for scholar review." ambient="hall" noindex={true}>
  <section class="wrap max-w-4xl py-12">
    <h1 class="text-3xl font-bold text-white">Course Studio</h1>
    <p class="mt-2 text-white/85">Draft a course, then submit it for scholar review. Nothing here is public until an admin approves it and it's merged into the live catalogue.</p>
    <div id="app" class="mt-8"><p class="text-white/70">Loading…</p></div>
  </section>
  <script>
    import { expandYoutubeEmbeds, extractYoutubeId } from '../lib/lesson-embeds';
    const esc = (s: unknown) => String(s == null ? '' : s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c] as string));
    const app = document.getElementById('app')!;
    let topics: any[] = [];
    const api = (p: string, o?: RequestInit) => fetch(p, { credentials: 'same-origin', headers: { 'content-type': 'application/json' }, ...(o || {}) })
      .then((r) => r.json().then((d) => ({ ok: r.ok, d })));

    async function loadTopics() {
      if (topics.length) return topics;
      try { const data = await fetch('/data/index.json').then((r) => r.json()); topics = data.topics || []; } catch (e) {}
      return topics;
    }

    function draftListItem(d: any) {
      const statusColor = d.status === 'draft' ? 'bg-paper text-muted' : d.status === 'submitted' || d.status === 'in_review' ? 'bg-surface text-navy' : d.status === 'changes_requested' ? 'bg-saffron-soft text-saffron-deep' : d.status === 'approved' ? 'bg-ok/20 text-ok' : 'bg-paper text-muted';
      return `<a href="#" data-open="${esc(d.id)}" class="glass-lite block p-4 hover:-translate-y-0.5 transition">
        <div class="flex items-center gap-2"><span class="font-bold text-navy">${esc(d.title)}</span><span class="pill ${statusColor}">${esc(d.status)}</span></div>
        <div class="mt-1 font-sans text-xs text-muted">${esc(d.course_id)} · ${esc(d.topic)} · level ${esc(d.level)}</div>
      </a>`;
    }

    async function renderList() {
      const { ok, d } = await api('/api/studio/drafts');
      if (!ok) { app.innerHTML = '<p class="text-white/70">Sign in as a teacher to use the studio.</p>'; return; }
      const drafts = d.drafts || [];
      app.innerHTML = `
        <button id="new-draft" class="btn btn-primary">+ New draft</button>
        <div class="mt-6 grid gap-3 sm:grid-cols-2">${drafts.length ? drafts.map(draftListItem).join('') : '<p class="text-white/70">No drafts yet.</p>'}</div>`;
      document.querySelectorAll('[data-open]').forEach((a) => a.addEventListener('click', (e) => { e.preventDefault(); renderEditor((a as HTMLElement).dataset.open!); }));
      document.getElementById('new-draft')!.addEventListener('click', async () => {
        await loadTopics();
        const v = await (window as any).suModalForm({ title: 'New draft', submitLabel: 'Create', fields: [
          { name: 'courseId', label: 'Course id (url-safe slug)' },
          { name: 'title', label: 'Title' },
          { name: 'topic', label: `Topic (one of: ${topics.map((t) => t.id).join(', ')})` },
          { name: 'level', label: 'Level (100, 200, 300…)', type: 'number' },
          { name: 'summary', label: 'Summary (min 40 characters)', type: 'textarea' },
        ] });
        if (!v) return;
        const r = await api('/api/studio/drafts', { method: 'POST', body: JSON.stringify({ courseId: v.courseId, title: v.title, topic: v.topic, level: Number(v.level), summary: v.summary }) });
        if (r.ok) renderEditor(r.d.id); else (window as any).suToast(r.d.error || 'Could not create draft.', 'error');
      });
    }

    async function renderEditor(id: string) {
      const { ok, d } = await api('/api/studio/draft?id=' + encodeURIComponent(id));
      if (!ok) { (window as any).suToast('Could not load draft.', 'error'); return; }
      const { draft, lessons, quiz } = d;
      let meta: any = {}; try { meta = JSON.parse(draft.meta); } catch (e) {}
      const editable = draft.status === 'draft' || draft.status === 'changes_requested';

      app.innerHTML = `
        <button id="back" class="font-sans text-sm text-white/80 underline">&larr; All drafts</button>
        <div class="glass-strong mt-4 rounded-xl2 p-6">
          <div class="flex items-center gap-2"><h2 class="text-2xl font-bold text-navy">${esc(draft.title)}</h2><span class="pill bg-surface text-navy">${esc(draft.status)}</span></div>
          ${draft.review_notes ? `<div class="mt-2 rounded-xl border-l-4 border-saffron bg-surface p-3 text-sm"><strong>Reviewer notes:</strong> ${esc(draft.review_notes)}</div>` : ''}
          <p class="mt-1 font-sans text-xs text-muted">${esc(draft.course_id)} · ${esc(draft.topic)} · level ${esc(draft.level)}</p>

          <div class="mt-4 grid gap-2">
            <label class="block font-sans text-sm font-semibold">Summary<textarea id="f-summary" rows="2" class="mt-1 w-full rounded-xl border border-line bg-surface px-3 py-2 font-sans" ${editable ? '' : 'disabled'}>${esc(meta.summary || '')}</textarea></label>
            <label class="block font-sans text-sm font-semibold">Created with AI assistance?
              <select id="f-ai" class="mt-1 rounded-xl border border-line bg-surface px-3 py-2 font-sans" ${editable ? '' : 'disabled'}>
                <option value="true" ${meta.aiAssisted ? 'selected' : ''}>Yes</option>
                <option value="false" ${meta.aiAssisted === false ? 'selected' : ''}>No</option>
              </select>
            </label>
            ${editable ? '<button id="save-meta" class="btn justify-self-start">Save summary/declaration</button>' : ''}
          </div>

          <h3 class="mt-6 text-lg font-bold">Lessons</h3>
          <div id="lessons"></div>
          ${editable ? '<button id="add-lesson" class="btn mt-3">+ Add lesson</button>' : ''}

          <h3 class="mt-8 text-lg font-bold">Quiz</h3>
          <div id="quiz-editor"></div>
          ${editable ? '<button id="save-quiz" class="btn mt-2">Save quiz</button>' : ''}

          <h3 class="mt-8 text-lg font-bold">Validation</h3>
          <button id="validate" class="btn">Check readiness</button>
          <div id="validate-out" class="mt-2 font-sans text-sm"></div>

          ${editable ? '<button id="submit-draft" class="btn btn-primary mt-6">Submit for review</button>' : ''}
        </div>`;

      document.getElementById('back')!.addEventListener('click', renderList);

      function lessonMedia(ls: any): any[] {
        try { return Array.isArray(ls.media) ? ls.media : JSON.parse(ls.media || '[]'); } catch (e) { return []; }
      }

      function renderLessons() {
        const box = document.getElementById('lessons')!;
        box.innerHTML = lessons.map((ls: any, i: number) => {
          const media = lessonMedia(ls);
          return `
          <div class="mt-3 rounded-xl2 border border-line bg-surface p-4" data-lesson="${i}">
            <input class="w-full rounded-lg border border-line bg-paper px-2 py-1 font-sans text-sm font-semibold" data-l-title value="${esc(ls.title)}" ${editable ? '' : 'disabled'} />
            <textarea rows="6" class="mt-2 w-full rounded-lg border border-line bg-paper px-2 py-1 font-mono text-xs" data-l-html ${editable ? '' : 'disabled'}>${esc(ls.html)}</textarea>
            <div class="mt-2 grid gap-1 sm:grid-cols-2">
              <div><p class="font-sans text-xs font-bold uppercase text-muted">Live preview</p><div class="lesson-prose mt-1 rounded-lg border border-line bg-paper p-3 text-sm" data-l-preview>${expandYoutubeEmbeds(ls.html)}</div></div>
            </div>
            <div class="mt-3 rounded-lg border border-line bg-paper p-2" data-l-media>
              <p class="font-sans text-xs font-bold uppercase text-muted">Attached media</p>
              <ul class="mt-1 space-y-1" data-media-list>${media.map((m: any, mi: number) => `<li class="flex items-center gap-2 font-sans text-xs"><span class="pill bg-surface text-navy">${esc(m.kind || 'file')}</span><span class="truncate">${esc(m.caption || m.key)}</span>${editable ? `<button class="ml-auto underline" data-remove-media="${mi}">Remove</button>` : ''}</li>`).join('') || '<li class="font-sans text-xs text-muted">None yet.</li>'}</ul>
              ${editable ? `
              <div class="mt-2 flex flex-wrap items-center gap-2">
                <label class="font-sans text-xs">Photo/PDF <input type="file" accept="image/jpeg,image/png,image/webp,application/pdf" data-upload-doc class="block text-xs" /></label>
                <label class="font-sans text-xs">Video <input type="file" accept="video/mp4,video/webm" data-upload-video class="block text-xs" /></label>
                <button type="button" class="btn font-sans text-xs" data-insert-youtube>+ YouTube embed</button>
              </div>
              <div class="mt-1 font-sans text-xs text-muted" data-media-note></div>` : ''}
            </div>
            ${editable ? `<div class="mt-2 flex gap-2"><button class="btn font-sans text-xs" data-save-lesson>Save lesson</button><button class="btn font-sans text-xs" data-delete-lesson>Delete</button></div>` : ''}
          </div>`;
        }).join('');

        box.querySelectorAll('[data-l-html]').forEach((ta) => ta.addEventListener('input', (e) => {
          const card = (e.target as HTMLElement).closest('[data-lesson]')!;
          (card.querySelector('[data-l-preview]') as HTMLElement).innerHTML = expandYoutubeEmbeds((e.target as HTMLTextAreaElement).value);
        }));
        box.querySelectorAll('[data-save-lesson]').forEach((btn, i) => btn.addEventListener('click', async () => {
          const card = box.querySelectorAll('[data-lesson]')[i];
          const title = (card.querySelector('[data-l-title]') as HTMLInputElement).value;
          const html = (card.querySelector('[data-l-html]') as HTMLTextAreaElement).value;
          const media = lessonMedia(lessons[i]);
          const r = await api('/api/studio/lesson', { method: 'POST', body: JSON.stringify({ draftId: id, idx: i, title, html, media }) });
          (window as any).suToast(r.ok ? 'Lesson saved.' : (r.d.error || 'Could not save lesson.'), r.ok ? 'ok' : 'error');
          if (r.ok) { lessons[i] = { ...lessons[i], title, html }; }
        }));
        box.querySelectorAll('[data-delete-lesson]').forEach((btn, i) => btn.addEventListener('click', async () => {
          lessons.splice(i, 1);
          await api('/api/studio/draft', { method: 'POST', body: JSON.stringify({ id, action: 'reorder_lessons', order: lessons.map((_: any, j: number) => j) }) });
          renderLessons();
        }));

        box.querySelectorAll('[data-insert-youtube]').forEach((btn, i) => btn.addEventListener('click', () => {
          const url = prompt('Paste a YouTube URL or video id:');
          if (!url) return;
          const videoId = extractYoutubeId(url);
          if (!videoId) { (window as any).suToast('Could not recognize a YouTube video id in that.', 'error'); return; }
          const card = box.querySelectorAll('[data-lesson]')[i];
          const ta = card.querySelector('[data-l-html]') as HTMLTextAreaElement;
          ta.value = ta.value + (ta.value.endsWith('\n') ? '' : '\n\n') + `[[youtube:${videoId}]]`;
          (card.querySelector('[data-l-preview]') as HTMLElement).innerHTML = expandYoutubeEmbeds(ta.value);
        }));

        box.querySelectorAll('[data-upload-doc]').forEach((input, i) => input.addEventListener('change', async (e) => {
          const file = (e.target as HTMLInputElement).files?.[0]; if (!file) return;
          const card = box.querySelectorAll('[data-lesson]')[i];
          const note = card.querySelector('[data-media-note]') as HTMLElement;
          const kind = file.type.startsWith('image/') ? 'photo' : 'pdf';
          note.textContent = 'Uploading…';
          const rightsHeaders: Record<string, string> = kind === 'pdf' ? { 'x-upload-rights': 'own', 'x-upload-rights-note': 'Teacher-authored course material' } : {};
          const res = await fetch('/api/upload', { method: 'POST', credentials: 'same-origin', headers: { 'x-upload-kind': kind, 'x-upload-context': `draft:${id}`, 'content-type': file.type, ...rightsHeaders }, body: file })
            .then((r) => r.json().then((d) => ({ ok: r.ok, d })));
          if (!res.ok) { note.textContent = res.d.error || 'Upload failed.'; return; }
          note.textContent = kind === 'pdf' ? 'Uploaded — awaiting admin rights approval before it can be attached to a submitted draft.' : 'Uploaded.';
          const media = lessonMedia(lessons[i]);
          media.push({ key: res.d.key, kind, caption: file.name });
          lessons[i] = { ...lessons[i], media: JSON.stringify(media) };
          renderLessons();
        }));

        box.querySelectorAll('[data-upload-video]').forEach((input, i) => input.addEventListener('change', async (e) => {
          const file = (e.target as HTMLInputElement).files?.[0]; if (!file) return;
          const card = box.querySelectorAll('[data-lesson]')[i];
          const note = card.querySelector('[data-media-note]') as HTMLElement;
          const rights = confirm('Confirm: you own the rights to this video (or it is openly licensed / you have permission to use it)?\nOK = yes, Cancel = do not upload.');
          if (!rights) return;
          note.textContent = 'Starting upload…';
          const create = await api('/api/upload/create', { method: 'POST', body: JSON.stringify({ kind: 'video', context: `draft:${id}`, filename: file.name, size: file.size, contentType: file.type, rights: 'own', rightsNote: 'Teacher-authored lecture video' }) });
          if (!create.ok) { note.textContent = create.d.error || 'Could not start upload.'; return; }
          const { key, uploadId, partSize } = create.d;
          const parts: { partNumber: number; etag: string }[] = [];
          try {
            let partNumber = 1;
            for (let offset = 0; offset < file.size; offset += partSize, partNumber++) {
              const chunk = file.slice(offset, offset + partSize);
              note.textContent = `Uploading part ${partNumber} (${Math.min(100, Math.round((offset / file.size) * 100))}%)…`;
              const partRes = await fetch(`/api/upload/part?key=${encodeURIComponent(key)}&uploadId=${uploadId}&partNumber=${partNumber}`, { method: 'PUT', credentials: 'same-origin', body: chunk })
                .then((r) => r.json().then((d) => ({ ok: r.ok, d })));
              if (!partRes.ok) throw new Error(partRes.d.error || 'part upload failed');
              parts.push({ partNumber, etag: partRes.d.etag });
            }
            const complete = await api('/api/upload/complete', { method: 'POST', body: JSON.stringify({ key, uploadId, parts }) });
            if (!complete.ok) throw new Error(complete.d.error || 'could not finalize upload');
            note.textContent = 'Video uploaded — awaiting admin rights approval before it can be attached to a submitted draft.';
            const media = lessonMedia(lessons[i]);
            media.push({ key, kind: 'video', caption: file.name });
            lessons[i] = { ...lessons[i], media: JSON.stringify(media) };
            renderLessons();
          } catch (err: any) {
            note.textContent = err.message || 'Video upload failed.';
            await api('/api/upload/abort', { method: 'POST', body: JSON.stringify({ key, uploadId }) });
          }
        }));

        box.querySelectorAll('[data-remove-media]').forEach((btn) => btn.addEventListener('click', (e) => {
          const card = (e.target as HTMLElement).closest('[data-lesson]')!;
          const i = Number(card.getAttribute('data-lesson'));
          const mi = Number((e.target as HTMLElement).getAttribute('data-remove-media'));
          const media = lessonMedia(lessons[i]);
          media.splice(mi, 1);
          lessons[i] = { ...lessons[i], media: JSON.stringify(media) };
          renderLessons();
        }));
      }
      renderLessons();

      if (editable) document.getElementById('add-lesson')!.addEventListener('click', () => {
        lessons.push({ idx: lessons.length, title: 'New lesson', summary: '', html: '<p>Write your lesson here.</p>', media: null });
        renderLessons();
      });

      function renderQuiz() {
        const box = document.getElementById('quiz-editor')!;
        box.innerHTML = quiz.map((q: any, i: number) => {
          const options = Array.isArray(q.options) ? q.options : JSON.parse(q.options || '[]');
          return `<div class="mt-3 rounded-xl2 border border-line bg-surface p-4" data-q="${i}">
            <input class="w-full rounded-lg border border-line bg-paper px-2 py-1 font-sans text-sm" data-q-text value="${esc(q.q)}" ${editable ? '' : 'disabled'} />
            <div class="mt-2 grid gap-1" data-q-options>${options.map((o: string, oi: number) => `<div class="flex items-center gap-2"><input type="radio" name="ans-${i}" data-q-answer value="${oi}" ${q.answer === oi ? 'checked' : ''} ${editable ? '' : 'disabled'} /><input class="flex-1 rounded-lg border border-line bg-paper px-2 py-1 font-sans text-sm" data-q-option value="${esc(o)}" ${editable ? '' : 'disabled'} /></div>`).join('')}</div>
            ${editable ? '<button class="mt-1 font-sans text-xs underline" data-add-option>+ option</button> <button class="mt-1 font-sans text-xs underline" data-delete-q>Delete question</button>' : ''}
          </div>`;
        }).join('') + (editable ? '<button id="add-q" class="btn mt-2 font-sans text-xs">+ Add question</button>' : '');

        box.querySelectorAll('[data-add-option]').forEach((btn, i) => btn.addEventListener('click', () => { const o = Array.isArray(quiz[i].options) ? quiz[i].options : JSON.parse(quiz[i].options || '[]'); o.push('New option'); quiz[i].options = o; renderQuiz(); }));
        box.querySelectorAll('[data-delete-q]').forEach((btn, i) => btn.addEventListener('click', () => { quiz.splice(i, 1); renderQuiz(); }));
        const addQ = document.getElementById('add-q'); if (addQ) addQ.addEventListener('click', () => { quiz.push({ q: 'New question', options: ['Option A', 'Option B'], answer: 0 }); renderQuiz(); });
      }
      renderQuiz();

      if (editable) document.getElementById('save-meta')!.addEventListener('click', async () => {
        const summary = (document.getElementById('f-summary') as HTMLTextAreaElement).value;
        const aiAssisted = (document.getElementById('f-ai') as HTMLSelectElement).value === 'true';
        const r = await api('/api/studio/draft', { method: 'POST', body: JSON.stringify({ id, action: 'update_meta', summary, aiAssisted }) });
        (window as any).suToast(r.ok ? 'Saved.' : (r.d.error || 'Could not save.'), r.ok ? 'ok' : 'error');
      });

      if (editable) document.getElementById('save-quiz')!.addEventListener('click', async () => {
        const questions = [...document.querySelectorAll('[data-q]')].map((card) => ({
          q: (card.querySelector('[data-q-text]') as HTMLInputElement).value,
          options: [...card.querySelectorAll('[data-q-option]')].map((i) => (i as HTMLInputElement).value),
          answer: Number((card.querySelector('[data-q-answer]:checked') as HTMLInputElement)?.value ?? 0),
        }));
        const r = await api('/api/studio/quiz', { method: 'POST', body: JSON.stringify({ draftId: id, questions }) });
        (window as any).suToast(r.ok ? 'Quiz saved.' : (r.d.error || 'Could not save quiz.'), r.ok ? 'ok' : 'error');
      });

      document.getElementById('validate')!.addEventListener('click', async () => {
        const r = await api('/api/studio/validate?id=' + encodeURIComponent(id));
        const out = document.getElementById('validate-out')!;
        out.innerHTML = r.ok && r.d.valid ? '<p class="text-ok font-semibold">Ready to submit.</p>' : '<ul class="list-disc pl-5 text-danger">' + (r.d.errors || []).map((e: string) => `<li>${esc(e)}</li>`).join('') + '</ul>';
      });

      if (editable) document.getElementById('submit-draft')!.addEventListener('click', async () => {
        const r = await api('/api/studio/submit', { method: 'POST', body: JSON.stringify({ id }) });
        if (r.ok) { (window as any).suToast('Submitted for review.', 'ok'); renderList(); }
        else {
          const out = document.getElementById('validate-out')!;
          out.innerHTML = '<ul class="list-disc pl-5 text-danger">' + (r.d.errors || [r.d.error]).map((e: string) => `<li>${esc(e)}</li>`).join('') + '</ul>';
        }
      });
    }

    renderList();
  </script>
</Base>
