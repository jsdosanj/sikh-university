---
import Base from '../layouts/Base.astro';
---
<Base title="Reset password — Sikhi University" description="Reset the password on your Sikhi University account." ambient="hall" bgImage="/assets/backgrounds/login.jpg" noindex={true}>
  <section class="wrap py-14">
    <div class="mx-auto max-w-md text-center">
      <p class="eyebrow text-saffron">Reset password</p>
      <h1 class="text-display-sm mt-2 font-bold text-white" id="h1">Reset your password</h1>
      <p class="mt-2 font-sans text-white/85" id="sub">Enter your email and we'll send you a reset link.</p>
    </div>

    <div class="glass-strong mx-auto mt-6 max-w-md rounded-xl2 p-6">
      <!-- Request form: shown when no ?token is present -->
      <form id="request-form" class="space-y-4">
        <label class="block font-sans text-sm font-semibold"><span>Email</span>
          <input id="req-email" type="email" required placeholder="you@example.com" class="mt-1 w-full rounded-xl border border-line bg-surface px-4 py-2.5 font-sans focus:border-saffron focus:outline-none" />
        </label>
        <button id="req-btn" type="submit" class="btn btn-primary w-full justify-center">Send reset link</button>
      </form>

      <!-- Set-password form: shown when ?token is present -->
      <form id="reset-form" class="space-y-4 hidden">
        <label class="block font-sans text-sm font-semibold"><span>New password</span>
          <input id="password" type="password" required minlength="12" autocomplete="new-password" class="mt-1 w-full rounded-xl border border-line bg-surface px-4 py-2.5 font-sans focus:border-saffron focus:outline-none" />
        </label>
        <label class="block font-sans text-sm font-semibold"><span>Confirm password</span>
          <input id="confirm" type="password" required minlength="12" autocomplete="new-password" class="mt-1 w-full rounded-xl border border-line bg-surface px-4 py-2.5 font-sans focus:border-saffron focus:outline-none" />
        </label>
        <button id="reset-btn" type="submit" class="btn btn-primary w-full justify-center">Reset password</button>
      </form>
    </div>
    <div id="out" class="mx-auto mt-4 max-w-md"></div>
  </section>
  <script>
    function esc(s: string) { return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;'); }
    const params = new URLSearchParams(location.search);
    const token = params.get('token');
    const out = document.getElementById('out')!;
    const requestForm = document.getElementById('request-form') as HTMLFormElement;
    const resetForm = document.getElementById('reset-form') as HTMLFormElement;

    if (token) {
      requestForm.classList.add('hidden');
      resetForm.classList.remove('hidden');
      document.getElementById('h1')!.textContent = 'Choose a new password';
      document.getElementById('sub')!.textContent = 'This link is single-use and expires in 1 hour.';

      resetForm.addEventListener('submit', (ev) => {
        ev.preventDefault();
        const password = (document.getElementById('password') as HTMLInputElement).value;
        const confirm = (document.getElementById('confirm') as HTMLInputElement).value;
        if (password !== confirm) { out.innerHTML = `<div class="rounded-xl border-l-4 border-saffron bg-surface p-3 font-sans text-sm"><strong>Passwords don't match.</strong></div>`; return; }
        const btn = document.getElementById('reset-btn') as HTMLButtonElement;
        btn.disabled = true; btn.textContent = 'Resetting…';
        fetch('/api/auth/reset-password', { method: 'POST', credentials: 'same-origin', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ token, password }) })
          .then((r) => r.json().then((d) => ({ ok: r.ok, d })))
          .then(({ ok, d }) => {
            btn.disabled = false; btn.textContent = 'Reset password';
            if (!ok) { out.innerHTML = `<div class="rounded-xl border-l-4 border-saffron bg-surface p-3 font-sans text-sm"><strong>${esc((d && d.error) || 'Could not reset password.')}</strong></div>`; return; }
            out.innerHTML = `<div class="rounded-xl border-l-4 border-ok bg-surface p-3 font-sans text-sm"><strong>Password reset.</strong> Redirecting…</div>`;
            location.href = d.mfaRequired ? '/mfa.html' : '/dashboard.html';
          })
          .catch(() => { btn.disabled = false; btn.textContent = 'Reset password'; out.innerHTML = '<div class="rounded-xl border-l-4 border-saffron bg-surface p-3 font-sans text-sm">Network error. Please try again.</div>'; });
      });
    } else {
      requestForm.addEventListener('submit', (ev) => {
        ev.preventDefault();
        const email = (document.getElementById('req-email') as HTMLInputElement).value.trim();
        if (!email) return;
        const btn = document.getElementById('req-btn') as HTMLButtonElement;
        btn.disabled = true; btn.textContent = 'Sending…';
        fetch('/api/auth/forgot-password', { method: 'POST', credentials: 'same-origin', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ email }) })
          .then(() => {
            btn.disabled = false; btn.textContent = 'Send reset link';
            out.innerHTML = `<div class="rounded-xl border-l-4 border-ok bg-surface p-3 font-sans text-sm"><strong>Check your email.</strong> If an account exists for ${esc(email)}, a reset link is on its way.</div>`;
          })
          .catch(() => { btn.disabled = false; btn.textContent = 'Send reset link'; out.innerHTML = '<div class="rounded-xl border-l-4 border-saffron bg-surface p-3 font-sans text-sm">Network error. Please try again.</div>'; });
      });
    }
  </script>
</Base>
