---
import Base from '../layouts/Base.astro';
---
<Base title="Teacher — Sikhi University" description="A teacher's public profile at Sikhi University." ambient="hall">
  <section class="wrap py-12">
    <div id="teacher-profile" class="glass rounded-xl2 p-6 sm:p-8">
      <p class="font-sans text-sm text-muted">Loading…</p>
    </div>
    <div id="teacher-courses"></div>
  </section>
  <script>
    import { iconSvg } from '../lib/icons';
    const esc = (s: unknown) => String(s == null ? '' : s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c] as string));

    function badge(level: string) {
      if (level === 'scholar') return `<span class="inline-flex items-center gap-1 rounded-full bg-saffron-soft px-2.5 py-1 font-sans text-xs font-semibold text-saffron">${iconSvg('shield', 'h-3.5 w-3.5')} Verified Scholar</span>`;
      if (level === 'identity') return `<span class="inline-flex items-center gap-1 rounded-full bg-surface px-2.5 py-1 font-sans text-xs font-semibold text-muted">${iconSvg('check', 'h-3.5 w-3.5')} Verified</span>`;
      return '';
    }

    function renderProfile(p: any) {
      const root = document.getElementById('teacher-profile')!;
      const paras = (p.bio || '').split('\n\n').filter(Boolean).map((t: string) => `<p class="mt-3 max-w-3xl text-lg text-muted">${esc(t)}</p>`).join('');
      root.innerHTML = `
        <div class="flex flex-wrap items-center gap-4">
          ${p.photoUrl ? `<img src="${esc(p.photoUrl)}" width="96" height="96" alt="${esc(p.displayName)}" class="rounded-xl2 border border-line object-cover" style="width:96px;height:96px" />` : ''}
          <div>
            <h1 class="text-3xl font-bold">${esc(p.displayName)}</h1>
            <div class="mt-1">${badge(p.verificationLevel)}</div>
          </div>
        </div>
        ${paras}
        ${p.credentials ? `<p class="mt-3 font-sans text-sm text-muted">${esc(p.credentials)}</p>` : ''}
        ${p.areas && p.areas.length ? `<div class="mt-4 flex flex-wrap gap-2">${p.areas.map((a: string) => `<span class="rounded-full border border-line px-2.5 py-1 font-sans text-xs">${esc(a)}</span>`).join('')}</div>` : ''}
        ${p.links && p.links.length ? `<div class="mt-4 flex flex-wrap gap-3 font-sans text-sm">${p.links.map((l: any) => `<a class="underline hover:text-saffron" href="${esc(l.url)}" target="_blank" rel="noopener">${esc(l.kind)}</a>`).join('')}</div>` : ''}
        ${p.claimedProfessor ? `<p class="mt-4 font-sans text-sm text-muted">Courses authored as <a class="underline" href="/professor/${esc(p.claimedProfessor.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, ''))}">${esc(p.claimedProfessor)}</a></p>` : ''}
      `;
    }

    async function renderCourses(p: any) {
      const root = document.getElementById('teacher-courses')!;
      try {
        const data = await fetch('/data/index.json').then((r) => r.json());
        const courses = (data.courses || []).filter((c: any) =>
          c.status === 'published' && ((p.claimedProfessor && c.professor === p.claimedProfessor) || (p.assignedCourseIds || []).includes(c.id))
        );
        if (!courses.length) return;
        root.innerHTML = `<h2 class="mt-10 text-xl font-bold text-white">Courses</h2>
          <div class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
            ${courses.map((c: any) => `<a href="/course/${esc(c.id)}" class="glass-lite block rounded-xl2 p-4 hover:-translate-y-1 transition"><div class="font-semibold">${esc(c.title)}</div></a>`).join('')}
          </div>`;
      } catch (e) { /* course list is an enhancement, not required for the profile itself */ }
    }

    const island = document.getElementById('profile-data');
    if (island) {
      const profile = JSON.parse(island.textContent || '{}');
      renderProfile(profile);
      renderCourses(profile);
    }
  </script>
</Base>
