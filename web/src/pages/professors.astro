---
import Base from '../layouts/Base.astro';
import Avatar from '../components/Avatar.astro';
import { professorList, profBio, profSlug } from '../lib/data';
const list = professorList().sort((a, b) => a.name.localeCompare(b.name));
---
<Base title="Our professors — Sikhi University" description="The Sikh scholars and writers whose works anchor Sikhi University's courses.">
  <header class="relative overflow-hidden bg-gradient-to-br from-brand via-navy-strong to-navy-deep text-white">
    <div aria-hidden="true" class="pattern-lattice absolute inset-0"></div>
    <div class="wrap relative py-16">
      <p class="eyebrow text-saffron">Faculty · Sikhi University</p>
      <h1 class="text-display-sm mt-3 font-bold text-white">Our professors</h1>
      <p class="mt-4 max-w-2xl text-lg text-white/85">Sikhi University courses are built on the works of leading Sikh scholars and writers. Each course is taught in the voice of, or drawn from, its author.</p>
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 bottom-0 h-20 bg-gradient-to-b from-transparent to-paper"></div>
  </header>

  <section class="wrap py-12">
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
      {list.map(({ name, courses }, i) => (
        <a href={`/professor/${profSlug(name)}`} class="card-lift reveal text-center" data-reveal-delay={(i % 4) * 70}>
          <div class="flex justify-center"><Avatar name={name} size={76} /></div>
          <h3 class="mt-3 text-base font-bold">{name}</h3>
          <div class="font-sans text-xs text-muted">{courses.length} course{courses.length === 1 ? '' : 's'}</div>
          <p class="mt-2 text-sm text-muted">{(profBio(name).split('. ')[0] || '') + (profBio(name) ? '.' : '')}</p>
        </a>
      ))}
    </div>
  </section>
</Base>
