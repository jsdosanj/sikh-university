---
import Base from '../../layouts/Base.astro';
import Avatar from '../../components/Avatar.astro';
import CourseCard from '../../components/CourseCard.astro';
import { professorList, profBio, profSlug, professorPhotos } from '../../lib/data';
export function getStaticPaths() {
  return professorList().map(({ name, courses }) => ({ params: { slug: profSlug(name) }, props: { name, courses } }));
}
const { name, courses } = Astro.props;
const bio = profBio(name);
const photo = professorPhotos[name];
const sorted = [...courses].sort((a, b) => a.level - b.level);
import { SITE, ldJson } from '../../lib/site';
// ProfilePage + Person structured data so professor pages are eligible for
// rich results. Kept honest: no invented affiliations or job titles — many
// professors are historical figures whose writings the courses are built from.
const personLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  mainEntity: {
    '@type': 'Person',
    name,
    url: `${SITE}/professor/${profSlug(name)}`,
    ...(bio ? { description: bio } : {}),
    // JSON-LD consumers need an absolute URL (photo.img is a bare relative path).
    ...(photo && photo.img ? { image: `${SITE}/${photo.img}` } : {}),
  },
};
---
<Base title={`${name} — Sikhi University`} description={bio || `${name} teaches courses at Sikhi University.`} ogType="profile" ambient="hall">
  <script type="application/ld+json" set:html={ldJson(personLd)} slot="head" />
  <section class="wrap py-12">
    <div class="glass rounded-xl2 p-6 sm:p-8">
      <a href="/professors" class="font-sans text-sm text-muted hover:text-navy">← All professors</a>
      <div class="mt-4 flex flex-wrap items-center gap-5">
        <Avatar name={name} size={110} />
        <div>
          <h1 class="text-3xl font-bold">{name}</h1>
          <div class="font-sans text-sm text-muted">{courses.length} course{courses.length === 1 ? '' : 's'}</div>
        </div>
      </div>
      {bio && <p class="mt-5 max-w-3xl text-lg text-muted">{bio}</p>}
      {photo && photo.img && (
        <p class="mt-2 font-sans text-xs text-muted">Portrait via {photo.source ? <a class="underline" href={photo.source} target="_blank" rel="noopener">{photo.credit || 'Wikimedia Commons'}</a> : (photo.credit || 'Wikimedia Commons')}.</p>
      )}
    </div>
    <h2 class="mt-10 text-xl font-bold text-white">Courses</h2>
    <div class="prof-courses mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
      {sorted.map((c) => <CourseCard course={c} />)}
    </div>
  </section>

</Base>
