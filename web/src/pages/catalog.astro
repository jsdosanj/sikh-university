---
import Base from '../layouts/Base.astro';
import CourseCard from '../components/CourseCard.astro';
import Icon from '../components/Icon.astro';
import { topics, published, topicName, paths, TOPIC_ICONS } from '../lib/data';
import programsData from '../../public/assets/data/programs.json';
const sorted = [...published].sort((a, b) => a.level - b.level);
const byId = Object.fromEntries(published.map((c) => [c.id, c]));
// NOTE: the `filt` class and the data-t / data-l attributes are JS hooks
// (see the script below — setActive() toggles bg-brand/text-white/border-navy/
// text-muted/bg-surface on these). Style around them, never rename them.
const btn = 'filt rounded-full border border-line bg-surface px-4 py-1.5 font-sans text-muted cursor-pointer transition duration-200 hover:-translate-y-px hover:border-saffron hover:text-navy hover:shadow-card';
import { SITE } from '../lib/site';
const itemListLd = {
  '@context': 'https://schema.org', '@type': 'ItemList',
  name: 'Sikhi University course catalogue', numberOfItems: sorted.length,
  itemListElement: sorted.map((c, i) => ({ '@type': 'ListItem', position: i + 1, url: `${SITE}/course/${c.id}`, name: c.title })),
};

// Values are icon names from web/src/lib/icons.ts (rendered via <Icon>).
const CURATED_ICONS: Record<string, string> = {
  gurbani: 'book', foundations: 'diya', 'history-journey': 'scroll', language: 'pen',
  'spiritual-practice': 'meditation', 'philosophy-thought': 'thought', 'arts-culture': 'palette',
  'modern-skills': 'robot', teekas: 'books',
};
const GRADS = [
  'from-brand to-navy-soft', 'from-[#8a5a14] to-[#c98a1a]', 'from-[#1d4e89] to-[#2f7d4f]',
  'from-[#5c3b8a] to-[#1d4e89]', 'from-[#0f7b6c] to-[#16335c]', 'from-[#a23b2e] to-[#8a5a14]',
];
const iconFor = (p: typeof paths[number]) =>
  p.id.startsWith('topic-') ? (TOPIC_ICONS[p.id.slice(6)] || 'book') : (CURATED_ICONS[p.id] || 'cap');
const featured = paths.filter((p) => !p.id.startsWith('topic-'));
const subjects = paths.filter((p) => p.id.startsWith('topic-'));
const withGrad = (list: typeof paths, offset: number) => list.map((p, gi) => ({ p, grad: GRADS[(gi + offset) % GRADS.length] }));
const progTypeOrder = ['certificate', 'associate', 'bachelor', 'master', 'giani'];
const progTypeLabel: Record<string, string> = { certificate: 'Certificates', associate: 'Associate Degree', bachelor: "Bachelor's Degrees", master: "Master's Degrees", giani: 'Giani — Highest Distinction' };
const progTypeBg: Record<string, string> = { certificate: 'bg-saffron-soft', associate: 'bg-blue-50 dark:bg-blue-950/20', bachelor: 'bg-paper', master: 'bg-navy/5 dark:bg-navy/20', giani: 'bg-saffron-soft' };
const grouped = progTypeOrder.map((t) => ({ type: t, label: progTypeLabel[t], programs: programsData.programs.filter((p) => p.type === t) }));
---
<Base title="Courses & learning paths — Sikhi University" description="Browse all Sikhi University courses by topic, or follow a guided learning path — history, theology, philosophy, language, music, the arts and modern skills." ambient="study" bgImage="/assets/backgrounds/catalog.jpg">
  <script type="application/ld+json" set:html={JSON.stringify(itemListLd)} slot="head" />

  <!-- Arrival band: the navy "entrance hall" of the library, layered over the study
       ambient. Lattice + saffron glow drift on scroll (transform only, desktop, and
       frozen by the global reduced-motion guard). Everything here is server-rendered
       text — nothing is gated on JS. -->
  <section class="relative isolate overflow-hidden bg-brand text-white">
    <div aria-hidden="true" data-parallax="0.12" class="pattern-lattice pointer-events-none absolute inset-x-0 -inset-y-32"></div>
    <div aria-hidden="true" data-parallax="0.05" class="glow-saffron pointer-events-none absolute -left-40 -top-56 h-[42rem] w-[42rem]"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-32 -bottom-40 h-[26rem] w-[26rem] rounded-full bg-navy-soft/40 blur-3xl"></div>
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 bottom-0 h-px bg-gradient-to-r from-transparent via-saffron/70 to-transparent"></div>

    <div class="wrap relative py-16 sm:py-20 lg:py-24">
      <p class="eyebrow-rule text-saffron" data-i18n="catalog.eyebrow">Catalogue</p>
      <h1 class="text-display mt-5 max-w-4xl font-bold text-white" data-i18n="catalog.h1">Courses &amp; learning paths</h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-white/85" data-i18n="catalog.sub">Browse every course by topic and level — or follow a guided path from foundations to advanced study.</p>

      <!-- Decorative summary figures. `#cat-count` is a live hook: renderCat() writes the
           filtered course count into it, so it carries no count-up animation. -->
      <div class="mt-12 flex flex-wrap items-start gap-x-14 gap-y-8 pb-1">
        <div class="reveal">
          <div class="stat-num text-saffron"><span id="cat-count">{sorted.length}</span></div>
          <div class="mt-2 font-sans text-sm text-white/70" data-i18n="catalog.courseslabel">courses</div>
        </div>
        <div class="reveal" data-reveal-delay="90">
          <div class="stat-num text-saffron">{topics.length}</div>
          <div class="mt-2 font-sans text-sm text-white/70">subjects</div>
        </div>
        <div class="reveal" data-reveal-delay="180">
          <div class="stat-num text-saffron">{paths.length}</div>
          <div class="mt-2 font-sans text-sm text-white/70">learning paths</div>
        </div>
        <div class="reveal hidden sm:block" data-reveal-delay="270">
          <div class="stat-num text-saffron">100%</div>
          <div class="mt-2 font-sans text-sm text-white/70">free, forever</div>
        </div>
      </div>
    </div>
  </section>

  <section class="wrap relative pb-16">
    <!-- Segmented control, straddling the seam between the navy band and the paper. -->
    <div id="tabbar" role="tablist" aria-label="Browse courses" data-i18n-aria="catalog.tabbar.aria" class="glass-strong relative z-30 -mt-7 inline-flex max-w-full rounded-full p-1.5 font-sans text-xs shadow-lift sm:text-sm">
      <button id="tab-paths-btn" role="tab" aria-controls="view-paths" aria-selected="true" class="rounded-full px-3 py-1.5 bg-brand text-white sm:px-4" data-i18n="catalog.tab.paths">Learning paths</button>
      <button id="tab-catalog-btn" role="tab" aria-controls="view-catalog" aria-selected="false" class="rounded-full px-3 py-1.5 sm:px-4" data-i18n="catalog.eyebrow">Catalogue</button>
      <button id="tab-programs-btn" role="tab" aria-controls="view-programs" aria-selected="false" class="rounded-full px-3 py-1.5 sm:px-4" data-i18n="catalog.tab.programs">Programs</button>
    </div>

    <!-- Catalogue view (hidden by default: guided paths lead so slow connections
         don't hit a wall of 558 cards before JS runs). -->
    <div id="view-catalog" role="tabpanel" aria-labelledby="tab-catalog-btn" class="mt-8" hidden>
      <div class="filterbar glass-strong sticky top-[4.5rem] z-30 p-4 sm:p-5">
        <div class="searchfield flex max-w-xl items-center gap-3 rounded-xl border border-line bg-paper px-4 transition">
          <Icon name="search" class="h-4 w-4 shrink-0 text-saffron-deep" />
          <input id="cat-search" type="search" placeholder="Search courses…" data-i18n-ph="catalog.search.ph" aria-label="Search courses" data-i18n-aria="catalog.search.aria"
            class="w-full bg-transparent py-2.5 font-sans outline-none" />
        </div>
        <div id="cat-filters" class="mt-4 flex flex-wrap gap-2 font-sans text-sm">
          <button data-t="all" class={btn} data-i18n="catalog.filter.all">All</button>
          {[...topics].sort((a, b) => a.name.localeCompare(b.name)).map((t) => <button data-t={t.id} class={btn}>{t.name}</button>)}
        </div>
        <div class="mt-4 h-px bg-gradient-to-r from-line via-line to-transparent"></div>
        <div id="level-filters" class="mt-4 flex flex-wrap items-center gap-2 font-sans text-sm">
          <span class="eyebrow self-center text-saffron-deep mr-2" data-i18n="catalog.filter.levellabel">Level</span>
          <button data-l="all" class={btn} data-i18n="catalog.filter.alllevels">All levels</button>
          {[100, 200, 300, 400, 500].map((l) => <button data-l={String(l)} class={btn}>{l}-level</button>)}
        </div>
      </div>
      <div id="cat-grid" class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
        {sorted.map((c) => (
          <div class="cat-item" data-topic={c.topic} data-level={String(Math.floor(c.level / 100) * 100)} data-hay={`${c.title} ${c.summary} ${c.professor} ${topicName(c.topic)}`.toLowerCase()}>
            <CourseCard course={c} />
          </div>
        ))}
      </div>
      <div id="cat-empty" class="glass mt-10 hidden p-10 text-center" aria-live="polite">
        <div class="flex flex-col items-center gap-3">
          <span class="inline-flex h-16 w-16 items-center justify-center rounded-full bg-saffron-soft text-saffron-deep ring-1 ring-saffron/25"><Icon name="folder" class="h-7 w-7" /></span>
          <p class="mt-1 font-serif text-2xl font-bold text-navy" data-i18n="catalog.empty.title">No courses match</p>
          <p class="max-w-sm font-sans text-sm text-muted" data-i18n="catalog.empty.sub">Try a different topic, level, or search term.</p>
          <button id="cat-clear" type="button" class="btn mt-2" data-i18n="catalog.empty.clear">Clear filters</button>
        </div>
      </div>
    </div>

    <!-- Learning paths view -->
    <div id="view-paths" role="tabpanel" aria-labelledby="tab-paths-btn" class="mt-8">
      <p class="max-w-3xl text-lg leading-relaxed text-muted" data-i18n="catalog.paths.intro">Follow a path from foundations to advanced study — finish one course to light up the next. Every course belongs to a path.</p>

      <details id="guided-journeys-section" class="sect group/sect glass mt-8 overflow-hidden" open>
        <summary class="sect-sum flex cursor-pointer list-none items-center gap-4 p-5 sm:p-6">
          <span aria-hidden="true" class="inline-flex h-12 w-12 shrink-0 items-center justify-center rounded-xl2 bg-saffron-soft text-saffron-deep ring-1 ring-saffron/30"><Icon name="compass" class="h-6 w-6" /></span>
          <div class="min-w-0 flex-1">
            <h2 class="text-2xl font-bold leading-tight" data-i18n="catalog.paths.guided.h">Guided journeys</h2>
            <p class="font-sans text-sm text-muted" data-i18n="catalog.paths.guided.sub">Hand-curated routes that weave across subjects.</p>
          </div>
          <span aria-hidden="true" class="chev shrink-0 text-lg text-muted transition-transform group-open/sect:rotate-180">▾</span>
        </summary>
        <div class="space-y-4 px-4 pb-6 sm:px-6">
        {withGrad(featured, 0).map(({ p, grad }) => (
          <details id={p.id} class="path group scroll-mt-24 overflow-hidden rounded-xl2 shadow-card ring-1 ring-black/5 transition duration-200 hover:shadow-lift">
            <summary class={`relative flex cursor-pointer list-none items-center gap-4 overflow-hidden bg-gradient-to-r ${grad} p-4 text-white`}>
              <span aria-hidden="true" class="pattern-lattice pointer-events-none absolute inset-0"></span>
              <span class="relative inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-white/15 ring-1 ring-white/25">
                <Icon name={iconFor(p)} class="h-6 w-6 text-white" />
              </span>
              <span class="relative min-w-0 flex-1">
                <span class="block text-lg font-bold leading-tight text-white">{p.name}</span>
                <span class="block font-sans text-xs text-white/80">{p.blurb}</span>
              </span>
              <span class="path-count relative shrink-0 rounded-full bg-white/20 px-3 py-1 font-sans text-xs font-semibold ring-1 ring-white/25" data-path={p.id}>{p.courseIds.length} courses</span>
              <span aria-hidden="true" class="chev relative shrink-0 text-lg transition-transform group-open:rotate-180">▾</span>
            </summary>
            <div class="bg-surface p-5">
              <div class="h-1.5 w-full overflow-hidden rounded-full bg-line/70"><div class="path-bar h-full rounded-full bg-saffron transition-all duration-700" data-path={p.id} style="width:0%"></div></div>
              <ol class="path-list mt-5">
                {p.courseIds.map((id) => byId[id] && (
                  <li><a class="font-semibold text-navy hover:text-saffron-deep" href={`/course/${id}`} data-course={id}>{byId[id].title}</a><div class="text-sm leading-snug text-muted">{byId[id].summary}</div></li>
                ))}
              </ol>
            </div>
          </details>
        ))}
        </div>
      </details>

      <details id="explore-by-subject-section" class="sect group/sect glass mt-8 overflow-hidden">
        <summary class="sect-sum flex cursor-pointer list-none items-center gap-4 p-5 sm:p-6">
          <span aria-hidden="true" class="inline-flex h-12 w-12 shrink-0 items-center justify-center rounded-xl2 bg-saffron-soft text-saffron-deep ring-1 ring-saffron/30"><Icon name="books" class="h-6 w-6" /></span>
          <div class="min-w-0 flex-1">
            <h2 class="text-2xl font-bold leading-tight" data-i18n="catalog.paths.subject.h">Explore by subject</h2>
            <p class="font-sans text-sm text-muted" data-i18n="catalog.paths.subject.sub">Every subject, with all its courses in order.</p>
          </div>
          <span aria-hidden="true" class="chev shrink-0 text-lg text-muted transition-transform group-open/sect:rotate-180">▾</span>
        </summary>
        <div class="space-y-4 px-4 pb-6 sm:px-6">
        {withGrad(subjects, 1).map(({ p, grad }) => (
          <details id={p.id} class="path group scroll-mt-24 overflow-hidden rounded-xl2 shadow-card ring-1 ring-black/5 transition duration-200 hover:shadow-lift">
            <summary class={`relative flex cursor-pointer list-none items-center gap-4 overflow-hidden bg-gradient-to-r ${grad} p-4 text-white`}>
              <span aria-hidden="true" class="pattern-lattice pointer-events-none absolute inset-0"></span>
              <span class="relative inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-white/15 ring-1 ring-white/25">
                <Icon name={iconFor(p)} class="h-6 w-6 text-white" />
              </span>
              <span class="relative min-w-0 flex-1">
                <span class="block text-lg font-bold leading-tight text-white">{p.name}</span>
                <span class="block font-sans text-xs text-white/80">{p.blurb}</span>
              </span>
              <span class="path-count relative shrink-0 rounded-full bg-white/20 px-3 py-1 font-sans text-xs font-semibold ring-1 ring-white/25" data-path={p.id}>{p.courseIds.length} courses</span>
              <span aria-hidden="true" class="chev relative shrink-0 text-lg transition-transform group-open:rotate-180">▾</span>
            </summary>
            <div class="bg-surface p-5">
              <div class="h-1.5 w-full overflow-hidden rounded-full bg-line/70"><div class="path-bar h-full rounded-full bg-saffron transition-all duration-700" data-path={p.id} style="width:0%"></div></div>
              <ol class="path-list mt-5">
                {p.courseIds.map((id) => byId[id] && (
                  <li><a class="font-semibold text-navy hover:text-saffron-deep" href={`/course/${id}`} data-course={id}>{byId[id].title}</a><div class="text-sm leading-snug text-muted">{byId[id].summary}</div></li>
                ))}
              </ol>
            </div>
          </details>
        ))}
        </div>
      </details>
    </div>

    <!-- Programs view -->
    <div id="view-programs" role="tabpanel" aria-labelledby="tab-programs-btn" class="mt-8" hidden>
      <p class="max-w-3xl text-lg leading-relaxed text-muted" data-i18n="catalog.programs.intro">Certificate to Giani — a full academic ladder, free and open to all.</p>
      <div class="glass mt-6 border-l-4 border-saffron p-5 font-sans text-sm" data-i18n="catalog.programs.disclaimer">
        Sikhi University is not an accredited university and these courses are for self-development only.
      </div>
      {grouped.map(({ type, label, programs }) => programs.length > 0 && (
        <div class="mt-14">
          <h2 class="flex items-center gap-5 text-2xl font-bold">
            <span class="shrink-0">{label}</span>
            <span aria-hidden="true" class="h-px flex-1 bg-gradient-to-r from-line to-transparent"></span>
          </h2>
          <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {programs.map((p) => (
              <a href={`/program/${p.id}`} class={`glass-lite relative flex flex-col gap-2 p-5 transition duration-200 hover:-translate-y-1.5 hover:border-saffron hover:shadow-lift active:scale-[.985] ${progTypeBg[type]}`}>
                <div class="flex items-center gap-3">
                  <Icon name={p.icon} class="h-8 w-8 shrink-0 text-saffron-deep" />
                  <div>
                    <div class="eyebrow text-muted">{p.abbreviation}</div>
                    <h3 class="mt-0.5 text-lg font-bold text-navy leading-tight">{p.title}</h3>
                    <div class="font-gur text-sm text-muted" lang="pa">{p.titleGur}</div>
                  </div>
                </div>
                <p class="flex-1 font-sans text-sm text-muted">{p.description.slice(0, 140)}…</p>
                <div class="mt-auto flex flex-wrap gap-3 border-t border-line pt-3 font-sans text-xs text-muted">
                  <span class="inline-flex items-center gap-1"><Icon name="books" class="h-3.5 w-3.5" />{p.courseIds.length} courses</span>
                  <span class="inline-flex items-center gap-1"><Icon name="clock" class="h-3.5 w-3.5" />{p.duration}</span>
                  <span class="inline-flex items-center gap-1"><Icon name="check-square" class="h-3.5 w-3.5" />{p.passMark}% to pass cumulative exam</span>
                </div>
              </a>
            ))}
          </div>
        </div>
      ))}
      <div class="glass mt-16 p-6 sm:p-8">
        <h2 class="text-2xl font-bold" data-i18n="catalog.programs.how.h">How programs work</h2>
        <ol class="how-list mt-6 space-y-4 font-sans text-sm text-muted">
          <li data-i18n="catalog.programs.how.li1">Complete all courses in the program — each has lectures, reading, and a quiz.</li>
          <li>Once every course is passed (70% quiz score), unlock the <strong>Cumulative Examination</strong>.</li>
          <li>Pass the cumulative exam with <strong>80% or higher</strong> to earn the credential.</li>
          <li data-i18n="catalog.programs.how.li4">Download your certificate and share your academic credential.</li>
        </ol>
        <p class="mt-6 border-t border-line pt-5 font-sans text-sm text-muted" data-i18n="catalog.programs.stackable">Programs are stackable — courses completed in a certificate count toward higher degrees. Your progress is always saved.</p>
      </div>
    </div>
  </section>

  <script type="application/json" id="paths-data" set:html={JSON.stringify(paths.map((p) => ({ id: p.id, courseIds: p.courseIds })))}></script>
  <script>
    import { iconSvg } from '../lib/icons';
    // --- Tabs (Catalogue / Learning paths / Programs) ---
    const vc = document.getElementById('view-catalog'), vp = document.getElementById('view-paths'), vprog = document.getElementById('view-programs');
    const bC = document.getElementById('tab-catalog-btn'), bP = document.getElementById('tab-paths-btn'), bProg = document.getElementById('tab-programs-btn');
    function setTab(which, push) {
      [['paths', vp, bP], ['catalog', vc, bC], ['programs', vprog, bProg]].forEach(([key, view, btn]) => { const on = key === which; view.hidden = !on; btn.classList.toggle('bg-brand', on); btn.classList.toggle('text-white', on); btn.classList.toggle('text-muted', !on); btn.setAttribute('aria-selected', on ? 'true' : 'false'); });
      if (push) history.replaceState(null, '', which === 'paths' ? '#paths' : which === 'programs' ? '#programs' : location.pathname);
    }
    bC.addEventListener('click', () => setTab('catalog', true));
    bP.addEventListener('click', () => setTab('paths', true));
    bProg.addEventListener('click', () => setTab('programs', true));

    // --- Catalogue filter + search ---
    const items = Array.from(document.querySelectorAll('.cat-item'));
    const filters = Array.from(document.querySelectorAll('#cat-filters .filt'));
    const levelBtns = Array.from(document.querySelectorAll('#level-filters .filt'));
    const search = document.getElementById('cat-search');
    const empty = document.getElementById('cat-empty');
    const countEl = document.getElementById('cat-count');
    const clearBtn = document.getElementById('cat-clear');
    let topic = 'all', level = 'all', q = '';
    const CAT_STATE_KEY = 'su_v1_catalog';
    function saveCatState() { try { localStorage.setItem(CAT_STATE_KEY, JSON.stringify({ topic, level })); } catch {} }
    function loadCatState() { try { const v = JSON.parse(localStorage.getItem(CAT_STATE_KEY)); return v && typeof v === 'object' ? v : null; } catch { return null; } }
    function setActive() {
      filters.forEach((b) => {
        const on = b.dataset.t === topic;
        b.classList.toggle('bg-brand', on); b.classList.toggle('text-white', on);
        b.classList.toggle('border-navy', on); b.classList.toggle('text-muted', !on);
        b.classList.toggle('bg-surface', !on);
        b.setAttribute('aria-pressed', String(on));
      });
      levelBtns.forEach((b) => {
        const on = b.dataset.l === level;
        b.classList.toggle('bg-brand', on); b.classList.toggle('text-white', on);
        b.classList.toggle('border-navy', on); b.classList.toggle('text-muted', !on);
        b.classList.toggle('bg-surface', !on);
        b.setAttribute('aria-pressed', String(on));
      });
    }
    function renderCat() {
      let shown = 0;
      items.forEach((el) => {
        const okT = topic === 'all' || el.dataset.topic === topic;
        const okL = level === 'all' || el.dataset.level === level;
        const okQ = !q || q.split(/\s+/).every((t) => el.dataset.hay.indexOf(t) !== -1);
        const vis = okT && okL && okQ; el.style.display = vis ? '' : 'none'; if (vis) shown++;
      });
      empty.classList.toggle('hidden', shown > 0);
      if (countEl) countEl.textContent = String(shown);
      setActive();
    }
    filters.forEach((b) => b.addEventListener('click', () => { topic = b.dataset.t; saveCatState(); renderCat(); }));
    levelBtns.forEach((b) => b.addEventListener('click', () => { level = b.dataset.l; saveCatState(); renderCat(); }));
    search.addEventListener('input', () => { q = search.value.toLowerCase().trim(); renderCat(); });
    if (clearBtn) clearBtn.addEventListener('click', () => { topic = 'all'; level = 'all'; q = ''; search.value = ''; saveCatState(); renderCat(); });

    // --- Path progress (server grades are the source of truth) ---
    const pdata = JSON.parse(document.getElementById('paths-data').textContent);
    const passed = (id) => { try { return !!localStorage.getItem('su_v1_passed_' + id); } catch { return false; } };
    function renderPaths() {
      pdata.forEach((p) => {
        const done = p.courseIds.filter(passed).length;
        const bar = document.querySelector(`.path-bar[data-path="${p.id}"]`);
        const cnt = document.querySelector(`.path-count[data-path="${p.id}"]`);
        if (bar) bar.style.width = (p.courseIds.length ? Math.round((done / p.courseIds.length) * 100) : 0) + '%';
        if (cnt) cnt.textContent = `${done} / ${p.courseIds.length} done`;
      });
      document.querySelectorAll('a[data-course]').forEach((a) => { if (passed(a.dataset.course) && !a.querySelector('.tick')) a.innerHTML += ' <span class="tick text-ok inline-flex align-[-0.15em]">' + iconSvg('check', 'h-4 w-4') + '</span>'; });
    }
    fetch('/api/progress', { credentials: 'same-origin' }).then((r) => (r.ok ? r.json() : null)).then((d) => {
      if (d && d.progress) d.progress.forEach((row) => { if (row.passed_score >= 80) { try { localStorage.setItem('su_v1_passed_' + row.course_id, JSON.stringify(row.passed_score)); } catch {} } });
      renderPaths();
    }).catch(renderPaths);

    // initial state: a topic filter (#<topic>) or level (#100 etc) opens the catalogue;
    // #catalog opens catalogue; #programs opens programs; everything else defaults to Learning paths.
    const hash = (location.hash || '').replace('#', '');
    if (hash && filters.some((b) => b.dataset.t === hash)) { topic = hash; setTab('catalog', false); }
    else if (hash && levelBtns.some((b) => b.dataset.l === hash)) { level = hash; setTab('catalog', false); }
    else {
      // no topic/level hash to honor — restore the last persisted catalogue filter state
      const savedCat = loadCatState();
      if (savedCat) {
        if (savedCat.topic && filters.some((b) => b.dataset.t === savedCat.topic)) topic = savedCat.topic;
        if (savedCat.level && levelBtns.some((b) => b.dataset.l === savedCat.level)) level = savedCat.level;
      }
      if (hash === 'catalog') setTab('catalog', false);
      else if (hash === 'programs') setTab('programs', false);
      else setTab('paths', false);
    }
    renderCat(); renderPaths();
  </script>

  <style>
    /* CSS-only fade when the catalogue grid first paints. Per-card reveal would
       replay every time the filter toggles display:none/'' on items, so the
       whole grid fades once instead. Frozen by the global reduced-motion guard. */
    @keyframes su-cat-fade { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
    #cat-grid { animation: su-cat-fade .5s cubic-bezier(.2,.7,.3,1) both; }

    /* Hero figures — display numerals, one notch under .text-display-sm so they
       read as data, not as a second headline. */
    .stat-num {
      font-family: "Source Serif 4", Georgia, serif; font-weight: 700;
      font-size: clamp(2rem, 1.5rem + 1.6vw, 2.75rem); line-height: 1; letter-spacing: -0.02em;
      font-variant-numeric: tabular-nums;
    }

    /* Segmented control. The script owns bg-brand/text-white/text-muted on these
       buttons; everything here keys off aria-selected so the two never fight. */
    #tabbar button { transition: color .15s var(--ease-out), box-shadow .3s var(--ease-out), transform .15s var(--ease-out); font-weight: 600; letter-spacing: .01em; }
    #tabbar button[aria-selected="true"] { box-shadow: 0 6px 16px rgb(11 30 58 / .28); }
    #tabbar button[aria-selected="false"]:hover { color: rgb(var(--c-navy)); }
    #tabbar button:active { transform: scale(.97); }

    /* Filter pills: the active pill keeps white text on navy even under :hover
       (the utility hover:text-navy would otherwise erase it). */
    .filt[aria-pressed="true"]:hover { color: #fff; }
    .filt[aria-pressed="true"] { box-shadow: 0 4px 12px rgb(11 30 58 / .22); }

    /* Search field inside the sticky filter bar: the wrapper carries the visible
       focus indicator, so the input doesn't paint a second ring inside it. */
    .searchfield:focus-within { border-color: rgb(244 178 26); box-shadow: 0 0 0 3px rgb(244 178 26 / .28); }
    .searchfield input:focus-visible { outline: none; }

    /* Collapsible sections: Safari still paints a marker without this. */
    summary::-webkit-details-marker { display: none; }
    .sect-sum, .path > summary { transition: background-color .2s var(--ease-out); }
    .sect-sum:hover { background: rgb(244 178 26 / .07); }
    .path > summary::after {
      content: ''; position: absolute; inset: 0; pointer-events: none;
      background: rgb(255 255 255 / 0); transition: background-color .2s var(--ease-out);
    }
    .path > summary:hover::after { background: rgb(255 255 255 / .07); }
    .path[open] { box-shadow: 0 14px 34px rgba(31, 111, 235, .18); }
    .chev { line-height: 1; }

    /* Numbered course rows inside a path — a manuscript-style ordinal medallion
       instead of a browser list marker. */
    .path-list { counter-reset: su-step; list-style: none; padding: 0; }
    .path-list > li {
      counter-increment: su-step; position: relative; padding: .45rem .6rem .5rem 2.9rem;
      border-radius: .6rem; transition: background-color .2s var(--ease-out);
    }
    .path-list > li:hover { background: rgb(244 178 26 / .09); }
    .path-list > li::before {
      content: counter(su-step); position: absolute; left: .5rem; top: .5rem;
      width: 1.7rem; height: 1.7rem; display: flex; align-items: center; justify-content: center;
      border-radius: 9999px; background: rgb(var(--c-paper)); border: 1px solid rgb(var(--c-line));
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      font-size: .72rem; font-weight: 700; color: rgb(var(--c-muted)); font-variant-numeric: tabular-nums;
    }

    /* "How programs work" — same ordinal medallion, on the glass panel. */
    .how-list { counter-reset: su-how; list-style: none; padding: 0; }
    .how-list > li { counter-increment: su-how; position: relative; padding-left: 2.9rem; min-height: 1.7rem; }
    .how-list > li::before {
      content: counter(su-how); position: absolute; left: 0; top: -.05rem;
      width: 1.7rem; height: 1.7rem; display: flex; align-items: center; justify-content: center;
      border-radius: 9999px; background: rgb(var(--c-saffron-soft)); border: 1px solid rgb(244 178 26 / .35);
      font-size: .72rem; font-weight: 700; color: rgb(var(--c-saffron-deep)); font-variant-numeric: tabular-nums;
    }

    /* High-contrast mode must never keep a translucent tint over glass. */
    :global(body.hc) .sect-sum:hover,
    :global(body.hc) .path-list > li:hover { background: transparent; }
  </style>
</Base>
