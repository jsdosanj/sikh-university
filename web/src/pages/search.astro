---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { professorList, profBio, profSlug } from '../lib/data';
import { REF, COLLECTIONS } from '../lib/santhya';
import gurbaniWords from '../data/gurbani-words.json';

// A universal index, built at compile time, of everything searchable that the
// course catalogue alone doesn't cover: professors (with bios), banis, scripture,
// collections, and the main pages. Courses, topics and paths are merged in at
// runtime from courses.json (already served to the browser).
const professors = professorList().map((p) => ({
  title: p.name, slug: profSlug(p.name), count: p.courses.length, bio: profBio(p.name),
}));

const granths = [
  { gur: 'ਸ੍ਰੀ ਗੁਰੂ ਗ੍ਰੰਥ ਸਾਹਿਬ ਜੀ', title: 'Sri Guru Granth Sahib Ji', url: '/santhiya?src=sggs', sub: 'Read Ang by Ang with Santhya audio' },
  { gur: 'ਦਸਮ ਗ੍ਰੰਥ', title: 'Dasam Granth', url: '/santhiya?src=dasam', sub: 'Read-along, Ang by Ang' },
  { gur: 'ਸ੍ਰੀ ਸਰਬਲੋਹ ਗ੍ਰੰਥ ਸਾਹਿਬ', title: 'Sri Sarbloh Granth Sahib', url: '/santhiya?src=sarbloh', sub: 'The Khalsa Mahima — read-along' },
];
const banis = Object.values(REF).map((b) => ({ gur: b.gur, title: b.en, url: b.href || '/santhiya', sub: 'Bani · read-along' }));
const collections = Object.entries(COLLECTIONS).map(([id, c]) => ({ gur: c.gur, title: c.name, url: '/collection/' + id, sub: c.blurb }));
const readings = [...granths, ...banis, ...collections];

const pages = [
  { title: 'Course catalogue', url: '/catalog', sub: 'Browse every course by topic' },
  { title: 'Learning paths', url: '/catalog#paths', sub: 'Guided, ordered routes through the courses' },
  { title: 'Santhya pathway & read-along', url: '/santhiya', sub: 'Learn to read Gurbani, and read the Granths' },
  { title: 'Baal Updesh — learn Gurmukhi', url: '/baal-updesh', sub: 'Alphabet, Muharni, words, numbers, flashcards' },
  { title: 'Flashcards', url: '/baal-updesh#flashcards', sub: 'Spaced-repetition study of Gurbani words & terms' },
  { title: 'Professors', url: '/professors', sub: 'The scholars behind the courses' },
  { title: 'My Learning', url: '/dashboard', sub: 'Your progress, grades and certificates' },
  { title: 'About Sikhi University', url: '/about', sub: 'Why we built this' },
  { title: 'Send feedback', url: '/feedback', sub: 'Report a correction or suggest a course' },
];

const gWords = (gurbaniWords as { gur: string; tr: string; var?: string; url: string }[]).map((w) => ({
  title: w.gur, sub: w.tr, url: w.url,
  hay: `${w.gur} ${w.tr} ${w.var || ''}`.toLowerCase(),
}));

const extra = { professors, readings, pages, gWords };

// Starter queries, drawn from the app's own bani register (web/src/lib/santhya.ts)
// so every Gurmukhi label here is verbatim from the corpus — never hand-typed.
// Plain links carrying ?q=, so they work before (and without) the page script.
const SUGGEST_IDS = ['japji', 'sukhmani', 'asadivar', 'anand'] as const;
const suggestions = SUGGEST_IDS.filter((id) => REF[id]).map((id) => REF[id]);
---
<Base title="Search — Sikhi University" description="Search everything at Sikhi University — courses, professors, topics, learning paths, banis and scripture." ambient="study">
  <!-- Reading-room search desk: a single wide field on warm paper, with the
       saffron study glow pooled behind it. All chrome is server-rendered; only
       the result list itself needs JS (search is inherently a live query). -->
  <section class="relative isolate">
    <div aria-hidden="true" class="glow-saffron pointer-events-none absolute -top-40 left-1/2 h-[34rem] w-[34rem] -translate-x-1/2 opacity-70"></div>

    <div class="wrap relative pt-14 pb-6 sm:pt-20">
      <p class="eyebrow-rule text-saffron-deep">Sikhi University</p>
      <h1 class="text-display mt-5 max-w-3xl font-bold" data-i18n="search.h1">Search Sikhi University</h1>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-muted">Courses, professors, learning paths, banis, scripture and Gurbani words — one field, the whole university.</p>

      <div class="searchfield glass-strong mt-9 flex max-w-3xl items-center gap-4 px-5 py-1 sm:px-6">
        <Icon name="search" class="h-5 w-5 shrink-0 text-saffron-deep" />
        <input id="q" type="search" aria-label="Search Sikhi University" data-i18n-aria="search.h1" placeholder="Search in English or ਪੰਜਾਬੀ — courses, banis, Gurbani words…" data-i18n-ph="search.ph" autofocus
          class="w-full bg-transparent py-4 font-sans text-lg outline-none sm:py-5" />
      </div>

      <div class="mt-6 flex flex-wrap items-center gap-2.5">
        <span class="eyebrow mr-1 text-muted">Try</span>
        {suggestions.map((b) => (
          <a href={`/search?q=${encodeURIComponent(b.en)}`} class="inline-flex items-baseline gap-2 rounded-full border border-line bg-surface px-3.5 py-1.5 shadow-card transition duration-200 hover:-translate-y-px hover:border-saffron hover:shadow-lift">
            <span class="gur text-navy" lang="pa">{b.gur}</span>
            <span class="font-sans text-xs text-muted">{b.en}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="wrap pb-16">
    <div id="out" class="mt-8" aria-live="polite"></div>
  </section>

  <style>
    /* The whole result list is injected via innerHTML, so anything that has to
       reach it must be :global — the Astro scope class is never stamped on
       dynamically-created nodes. (Tailwind utilities are already global.) */

    /* Highlight for matched query terms. Saffron-soft ground + ink text keeps AA
       contrast in both themes (see global.css tokens). */
    #out :global(mark) {
      background: rgb(var(--c-saffron-soft));
      color: rgb(var(--c-ink));
      border-radius: 3px;
      padding: 0 .15em;
    }

    /* The search desk: a saffron focus ring that reads as a lit lamp rather than
       a form outline. box-shadow only — never animate backdrop-filter. */
    .searchfield { transition: box-shadow .3s var(--ease-out), transform .3s var(--ease-out); }
    .searchfield:focus-within {
      box-shadow: 0 0 0 3px rgb(244 178 26 / .32), 0 18px 44px rgb(11 30 58 / .16);
      transform: translateY(-1px);
    }
    /* The field owns the focus ring; the input inside it does not double up. */
    .searchfield input:focus-visible { outline: none; }

    /* Result group headings: a hairline that trails off to the right. */
    #out :global(.res-head)::after {
      content: ''; flex: 1 1 auto; height: 1px;
      background: linear-gradient(90deg, rgb(var(--c-line)), transparent);
    }

    /* Each hit lifts on a gold hairline — the same language as .card-lift. */
    #out :global(.res-hit)::after {
      content: ''; position: absolute; inset: 0; border-radius: inherit; pointer-events: none;
      border: 1px solid transparent; transition: border-color .2s var(--ease-out);
    }
    #out :global(.res-hit:hover)::after,
    #out :global(.res-hit:focus-visible)::after { border-color: rgb(244 178 26 / .6); }

    /* Whisper-quiet entrance for the FIRST result set only (a ?q= deep link).
       Re-typing must not replay it — an animation on every keystroke would fight
       the reader. Frozen by the global reduced-motion guard. */
    @keyframes su-res-in { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }
    #out :global(.res-in) { animation: su-res-in .45s var(--ease-out) both; }
  </style>
  <script type="application/json" id="extra-index" set:html={JSON.stringify(extra)}></script>
  <script>
    import { iconSvg } from '../lib/icons';
    const esc = (s) => String(s == null ? '' : s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
    const reEsc = (s) => s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
    const extra = JSON.parse(document.getElementById('extra-index').textContent);
    let data = { courses: [], topics: [], paths: [] };
    const tn = (id) => (data.topics.find((t) => t.id === id) || {}).name || id;
    const out = document.getElementById('out'); const q = document.getElementById('q');

    // Build a flat, typed index. Each entry carries display fields (kind/title/sub/url)
    // plus four lowercased search fields the scorer weights: t = title, p = professor,
    // o = topic, b = body/summary. Non-course kinds leave p/o empty.
    // `gur` is display-only: the Gurmukhi half of a reading's name, kept in its own
    // field so the row can render it with lang="pa" in a real Gurmukhi face.
    let index = [];
    function buildIndex() {
      index = [];
      const push = (e) => index.push({ p: '', o: '', b: '', gur: '', ...e });
      data.courses.forEach((c) => push({
        kind: 'Course', title: c.title, sub: 'Prof. ' + c.professor + ' · ' + tn(c.topic), url: '/course/' + c.id,
        t: (c.title || '').toLowerCase(), p: (c.professor || '').toLowerCase(), o: tn(c.topic).toLowerCase(),
        b: [c.summary, (c.terms || []).map((x) => x.t + ' ' + x.m).join(' '), (c.outcomes || []).join(' '), (c.lessonTitles || []).join(' ')].join(' ').toLowerCase(),
      }));
      extra.professors.forEach((p) => push({
        kind: 'Professor', title: p.title, sub: p.count + ' course' + (p.count === 1 ? '' : 's'), url: '/professor/' + p.slug,
        t: (p.title || '').toLowerCase(), b: (p.bio || '').toLowerCase(),
      }));
      (data.topics || []).forEach((t) => push({
        kind: 'Topic', title: t.name, sub: t.blurb || '', url: '/catalog#' + t.id,
        t: (t.name || '').toLowerCase(), b: (t.blurb || '').toLowerCase(),
      }));
      (data.paths || []).forEach((p) => push({
        kind: 'Path', title: p.name, sub: (p.blurb || '') + ' · ' + (p.courseIds || []).length + ' courses', url: '/catalog#paths',
        t: (p.name || '').toLowerCase(), b: (p.blurb || '').toLowerCase(),
      }));
      extra.readings.forEach((r) => push({
        kind: 'Reading', title: r.title, gur: r.gur || '', sub: r.sub || '', url: r.url,
        t: ((r.gur || '') + ' ' + r.title).toLowerCase(), b: (r.sub || '').toLowerCase(),
      }));
      extra.pages.forEach((p) => push({
        kind: 'Page', title: p.title, sub: p.sub || '', url: p.url,
        t: (p.title || '').toLowerCase(), b: (p.sub || '').toLowerCase(),
      }));
      (extra.gWords || []).forEach((w) => push({
        kind: 'Word', title: w.title, sub: w.sub, url: w.url,
        t: (w.title || '').toLowerCase(), b: w.hay,
      }));
    }

    // Field-weighted scorer. A term at a word start scores double a mid-word substring.
    // Weights: title 5×, professor 3×, topic 2×, body 1×.
    function fieldScore(field, t) {
      if (!field) return 0;
      const i = field.indexOf(t);
      if (i === -1) return 0;
      const wordStart = i === 0 || !/[a-z0-9]/i.test(field[i - 1]);
      return wordStart ? 2 : 1;
    }
    function scoreEntry(r, terms, phrase) {
      let score = 0, present = 0;
      for (const t of terms) {
        const hit = fieldScore(r.t, t) * 5 + fieldScore(r.p, t) * 3 + fieldScore(r.o, t) * 2 + fieldScore(r.b, t);
        if (hit) present++;
        score += hit;
      }
      if (!score) return 0;
      if (present === terms.length) score += 4;               // all-terms-present bonus
      if (phrase && r.t.indexOf(phrase) !== -1) score += 20;   // exact phrase in title
      return score;
    }
    function search(terms, phrase) {
      const res = [];
      for (const r of index) { const s = scoreEntry(r, terms, phrase); if (s) res.push({ r, s }); }
      res.sort((a, b) => b.s - a.s);
      return res;
    }

    // Escape text, then wrap matched terms in <mark>. Matches are located in the raw
    // text and each segment escaped separately, so the query is never injected as HTML.
    function hl(text, terms) {
      text = String(text == null ? '' : text);
      const pat = terms.filter(Boolean).map(reEsc).sort((a, b) => b.length - a.length).join('|');
      if (!pat) return esc(text);
      const re = new RegExp('(' + pat + ')', 'gi');
      let html = '', last = 0, m;
      while ((m = re.exec(text))) {
        html += esc(text.slice(last, m.index)) + '<mark>' + esc(m[0]) + '</mark>';
        last = m.index + m[0].length;
        if (m.index === re.lastIndex) re.lastIndex++;
      }
      return html + esc(text.slice(last));
    }

    const ORDER = ['Course', 'Professor', 'Reading', 'Word', 'Path', 'Topic', 'Page'];
    const LABEL = { Course: 'Courses', Professor: 'Professors', Reading: 'Reading & Bani', Word: 'Gurbani Words', Path: 'Learning paths', Topic: 'Topics', Page: 'Pages' };
    // A shell for the non-result states (idle / no match / index failure) so they
    // read as a considered panel rather than stray text.
    const panel = (inner) => `<div class="glass-lite max-w-2xl p-6 sm:p-8">${inner}</div>`;
    function row(r, terms) {
      // Gurmukhi always gets lang="pa" + a real Gurmukhi face, and sits at or above
      // the optical size of the Latin line beside it (DESIGN.md, reverence rules).
      const isGur = r.kind === 'Word';
      const gur = r.gur ? `<span class="gur block leading-snug text-navy" lang="pa">${hl(r.gur, terms)}</span>` : '';
      const title = `<span class="${isGur ? 'gur ' : ''}block font-bold leading-snug text-navy"${isGur ? ' lang="pa"' : ''}>${hl(r.title, terms)}</span>`;
      return `<a href="${r.url}" class="res-hit glass-lite relative flex h-full flex-col p-5 transition duration-200 hover:-translate-y-1.5 hover:shadow-lift active:scale-[.985]">`
        + `<span class="pill mb-2.5 w-fit bg-paper text-muted ring-1 ring-line">${esc(r.kind)}</span>`
        + gur + title
        + (r.sub ? `<span class="mt-1.5 block font-sans text-sm text-muted">${hl(r.sub, terms)}</span>` : '')
        + `</a>`;
    }
    let firstPaint = true;   // the entrance animation plays once, not per keystroke
    function render() {
      const v = q.value.normalize('NFC').toLowerCase().trim();
      if (!v) { out.innerHTML = panel(`<p class="font-sans text-muted">Type to search ${index.length} things — courses, professors, banis, Gurbani words and more.</p>`); return; }
      let terms = v.split(/\s+/);
      let scored = search(terms, v);
      let note = '';
      if (!scored.length && terms.length > 1) {          // did-you-mean: drop the last term once
        const shorter = terms.slice(0, -1);
        const retry = search(shorter, shorter.join(' '));
        if (retry.length) { scored = retry; terms = shorter; note = shorter.join(' '); }
      }
      if (!scored.length) {
        // Empty state matches catalog.astro's pattern: icon + serif title + sans sub + CTA.
        out.innerHTML = `<div class="glass-lite mx-auto mt-2 max-w-md p-8 text-center"><div class="flex flex-col items-center gap-3"><span class="inline-flex h-14 w-14 items-center justify-center rounded-full bg-paper text-muted">${iconSvg('search', 'h-7 w-7')}</span><p class="font-serif text-lg font-bold text-navy">No results for "${esc(q.value)}"</p><p class="max-w-sm font-sans text-sm text-muted">Try a shorter word, a different spelling, or search in ਗੁਰਮੁਖੀ.</p><a class="btn mt-1" href="/catalog">Browse the catalogue</a></div></div>`;
        return;
      }
      const groups = {};
      scored.forEach(({ r }) => (groups[r.kind] = groups[r.kind] || []).push(r));  // globally score-sorted, so each group stays in order
      let html = '';
      if (note) html += `<p class="mb-2 font-sans text-sm text-muted">Showing results for: ${esc(note)}</p>`;
      html += `<p class="eyebrow mb-6 text-saffron-deep">${scored.length} result${scored.length === 1 ? '' : 's'}</p>`;
      let firstGroup = true;
      ORDER.forEach((k) => {
        const g = groups[k]; if (!g || !g.length) return;
        html += `<h2 class="res-head mb-4 ${firstGroup ? '' : 'mt-12'} flex items-center gap-4 text-xl font-bold text-navy">`
          + `<span class="shrink-0">${LABEL[k]}</span>`
          + `<span class="shrink-0 font-sans text-xs font-bold tracking-widest text-muted">${g.length}</span>`
          + `</h2>`
          + `<div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">${g.map((r) => row(r, terms)).join('')}</div>`;
        firstGroup = false;
      });
      out.innerHTML = `<div class="${firstPaint ? 'res-in' : ''}">${html}</div>`;
      firstPaint = false;
    }
    // Deep-linked queries (?q=…) fill the input immediately and show a shimmer
    // skeleton while the index downloads, instead of a blank flash.
    const pre = new URLSearchParams(location.search).get('q');
    if (pre) {
      q.value = pre;
      out.innerHTML = `<div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4" aria-hidden="true">${'<div class="skeleton h-24"></div>'.repeat(8)}</div>`;
    }
    fetch('/data/search.json').then((r) => r.json()).then((d) => {
      data = d; buildIndex();
      render();
    }).catch(() => { out.innerHTML = panel('<p class="font-sans text-muted">Could not load the search index.</p>'); });
    q.addEventListener('input', render);
  </script>
</Base>
