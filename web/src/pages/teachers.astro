---
import Base from '../layouts/Base.astro';
---
<Base title="Our teachers — Sikhi University" description="Meet the living teachers of Sikhi University — verified educators sharing Gurbani, Gurmat, history and more." ambient="hall">
  <header class="relative overflow-hidden text-white">
    <div aria-hidden="true" data-parallax="0.15" class="pattern-lattice pointer-events-none absolute inset-0"></div>
    <div class="wrap relative py-16">
      <p class="eyebrow text-saffron">Faculty · Sikhi University</p>
      <h1 class="text-display-sm mt-3 font-bold text-white">Our teachers</h1>
      <p class="mt-4 max-w-2xl text-lg text-white/85">Living teachers on Sikhi University today — sign in and apply to join them.</p>
    </div>
  </header>
  <section class="wrap py-12">
    <div id="teachers-grid"><p class="font-sans text-sm text-muted">Loading…</p></div>
  </section>
  <script>
    import { iconSvg } from '../lib/icons';
    const esc = (s: unknown) => String(s == null ? '' : s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c] as string));
    function badge(level: string) {
      if (level === 'scholar') return `<span class="inline-flex items-center gap-1 rounded-full bg-saffron-soft px-2 py-0.5 font-sans text-xs font-semibold text-saffron">${iconSvg('shield', 'h-3 w-3')} Scholar</span>`;
      if (level === 'identity') return `<span class="inline-flex items-center gap-1 rounded-full bg-surface px-2 py-0.5 font-sans text-xs font-semibold text-muted">${iconSvg('check', 'h-3 w-3')} Verified</span>`;
      return '';
    }
    fetch('/api/teachers').then((r) => r.json()).then(({ teachers }) => {
      const grid = document.getElementById('teachers-grid')!;
      if (!teachers || !teachers.length) {
        grid.innerHTML = '<div class="rounded-xl2 border border-line bg-surface p-6 text-center text-muted">No public teacher profiles yet.</div>';
        return;
      }
      grid.innerHTML = `<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
        ${teachers.map((t: any) => `
          <a href="/teacher/${esc(t.slug)}" class="glass-lite relative block p-5 text-center transition duration-200 hover:-translate-y-1.5 hover:shadow-lift active:scale-[.985]">
            ${t.photoUrl ? `<img src="${esc(t.photoUrl)}" width="76" height="76" loading="lazy" alt="${esc(t.displayName)}" class="mx-auto rounded-xl2 border border-line object-cover" style="width:76px;height:76px" />` : ''}
            <h3 class="mt-3 text-base font-bold">${esc(t.displayName)}</h3>
            <div class="mt-1">${badge(t.verificationLevel)}</div>
            ${t.areas && t.areas.length ? `<p class="mt-2 text-sm text-muted">${esc(t.areas.slice(0, 3).join(', '))}</p>` : ''}
          </a>`).join('')}
      </div>`;
    }).catch(() => {
      document.getElementById('teachers-grid')!.innerHTML = '<div class="rounded-xl2 border border-line bg-surface p-6 text-center text-muted">Could not load teachers.</div>';
    });
  </script>
</Base>
