---
import Base from '../../../layouts/Base.astro';
import InstituteRail from '../../../components/institute/InstituteRail.astro';
import { workshops } from '../../../data/institute/workshops';
---
<Base
  title="Workshops — Institute of Technology"
  description="Hands-on 'how it is actually made' references from the Institute of Technology. First: the Wootz Workshop — the real metallurgy behind Sikh shastar."
  institute
>
  <InstituteRail />

  <section class="i-wrap i-wk-head">
    <span class="i-label">/technology/workshop</span>
    <h1>Workshops</h1>
    <p class="i-prose">
      Field records for how things are actually made — the recipe, the numbers, the tradeoffs.
      Migrated and kept current from the sister project, <a href="https://sikhi.io" target="_blank" rel="noopener">Sikhi.io</a>.
    </p>

    <div class="i-wk-grid">
      {workshops.map((w) => (
        <a class="i-panel i-wk-card" href={`/technology/workshop/${w.slug}`}>
          <span class="i-label">{w.kicker}</span>
          <strong class="i-wk-card-t">{w.title}</strong>
          <span class="i-prose i-wk-card-b">{w.standfirst}</span>
          <span class="i-mono i-wk-go">{w.modules.length} modules &rarr;</span>
        </a>
      ))}
    </div>
  </section>

  <style>
    .i-wk-head { padding: clamp(40px, 8vw, 72px) 24px clamp(48px, 9vw, 88px); }
    .i-wk-head h1 { margin: 8px 0 12px; font-size: clamp(28px, 5vw, 44px); }
    .i-wk-head > p { max-width: 66ch; }
    .i-wk-grid { display: grid; gap: 16px; margin-top: 32px; }
    @media (min-width: 720px) { .i-wk-grid { grid-template-columns: repeat(2, 1fr); } }
    .i-wk-card { display: flex; flex-direction: column; gap: 10px; padding: 26px; text-decoration: none; }
    .i-wk-card-t { font-family: "Chakra Petch", sans-serif; font-weight: 600; font-size: 20px; color: var(--i-ink); }
    .i-wk-card-b { color: var(--i-ink-dim); }
    .i-wk-go { margin-top: auto; color: var(--i-filament); font-size: 12px; }
  </style>
</Base>
