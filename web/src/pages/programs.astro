---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import programsData from '../../public/assets/data/programs.json';

const typeOrder = ['certificate', 'associate', 'bachelor', 'master', 'giani'];
const typeLabel = {
  certificate: 'Certificates',
  associate: 'Associate Degree',
  bachelor: "Bachelor's Degrees",
  master: "Master's Degrees",
  giani: 'Giani — Highest Distinction',
};
const typeBg = {
  certificate: 'bg-saffron-soft',
  associate: 'bg-blue-50 dark:bg-blue-950/20',
  bachelor: 'bg-paper',
  master: 'bg-[#e8edf6] dark:bg-[#313b4d]',
  giani: 'bg-saffron-soft',
};
const grouped = typeOrder.map((t) => ({
  type: t,
  label: typeLabel[t],
  programs: programsData.programs.filter((p) => p.type === t),
}));
---
<Base title="Degree Programs — Sikhi University" description="Certificate, Associate, Bachelor's, Master's and Giani degree programs in Sikh Studies — free, open, and comprehensive." ambient="hall">
  <section class="wrap py-12">
    <h1 class="text-3xl font-bold text-white" data-i18n="programs.h1">Academic Programs</h1>
    <p class="mt-3 max-w-2xl text-lg text-white/80" data-i18n="programs.sub">Sikhi University offers a full academic ladder — from introductory certificates through the prestigious Giani qualification. All programs are free and open to every learner worldwide.</p>

    <div class="mt-4 glass-strong border-l-4 border-saffron p-4 font-sans text-sm" data-i18n="programs.disclaimer">
      Sikhi University is not an accredited university and these courses are for self-development only.
    </div>

    {grouped.map(({ type, label, programs }) => programs.length > 0 && (
      <div class="mt-12">
        <h2 class="text-2xl font-bold border-b border-white/15 pb-2 text-white">{label}</h2>
        <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {programs.map((p) => (
            <a href={`/program/${p.id}`} class={`glass-card flex flex-col gap-2 hover:border-saffron transition ${typeBg[type]}`}>
              <div class="flex items-center gap-3">
                <Icon name={p.icon} class="h-8 w-8 shrink-0 text-saffron-deep" />
                <div>
                  <div class="font-sans text-xs font-bold uppercase tracking-wider text-muted">{p.abbreviation}</div>
                  <h3 class="text-lg font-bold text-navy leading-tight">{p.title}</h3>
                  <div class="font-gurmukhi text-sm text-muted">{p.titleGur}</div>
                </div>
              </div>
              <p class="font-sans text-sm text-muted flex-1">{p.description.slice(0, 140)}…</p>
              <div class="mt-auto flex flex-wrap gap-3 font-sans text-xs text-muted">
                <span class="inline-flex items-center gap-1"><Icon name="books" class="h-3.5 w-3.5" />{p.courseIds.length} courses</span>
                <span class="inline-flex items-center gap-1"><Icon name="clock" class="h-3.5 w-3.5" />{p.duration}</span>
                <span class="inline-flex items-center gap-1"><Icon name="check-square" class="h-3.5 w-3.5" />{p.passMark}% to pass cumulative exam</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    ))}

    <div class="mt-16 glass-strong rounded-xl2 p-6">
      <h2 class="text-xl font-bold" data-i18n="programs.how.h2">How programs work</h2>
      <ol class="mt-4 space-y-3 font-sans text-sm text-muted list-decimal list-inside">
        <li data-i18n="programs.how.step1">Complete all courses in the program — each has lectures, reading, and a quiz.</li>
        <li><span data-i18n="programs.how.step2a">Once every course is passed (70% quiz score), unlock the</span> <strong data-i18n="programs.how.step2b">Cumulative Examination</strong>.</li>
        <li><span data-i18n="programs.how.step3a">Pass the cumulative exam with</span> <strong data-i18n="programs.how.step3b">80% or higher</strong> <span data-i18n="programs.how.step3c">to earn the credential.</span></li>
        <li data-i18n="programs.how.step4">Download your certificate and share your academic credential.</li>
      </ol>
      <p class="mt-4 font-sans text-sm text-muted" data-i18n="programs.how.footer">Programs are stackable — courses completed in a certificate count toward higher degrees. Your progress is always saved.</p>
    </div>
  </section>
</Base>
