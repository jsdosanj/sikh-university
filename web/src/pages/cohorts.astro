---
import Base from '../layouts/Base.astro';
---
<Base title="Cohorts — Sikhi University" description="Learn together: join a cohort with an invite code, or (for teachers) create a cohort and track your group's progress." ambient="hall">
  <section class="wrap max-w-3xl py-12">
    <h1 class="text-3xl font-bold text-white" data-i18n="cohorts.h1">Cohorts</h1>
    <p class="mt-2 text-white/85" data-i18n="cohorts.sub">Learn together. Join a group with an invite code, or — if you teach a course — create a cohort and follow your group's progress. Made for camps, classes, and sangats studying as one.</p>
    <div id="app" class="mt-8"><p class="text-white/70" data-i18n="cohorts.loading">Loading…</p></div>
  </section>

  <script>
    const esc = (s) => String(s == null ? '' : s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
    const app = document.getElementById('app');
    const titles = {};
    let myCourses = []; // course ids the signed-in teacher actually teaches (from /api/gradebook)

    async function api(path, opts) {
      const r = await fetch(path, Object.assign({ credentials: 'same-origin' }, opts || {}));
      return { ok: r.ok, status: r.status, data: await r.json().catch(() => ({})) };
    }

    function joinBox() {
      return `
        <div class="glass-strong rounded-xl2 p-5">
          <h2 class="text-lg font-bold text-navy" data-i18n="cohorts.join.h2">Join a cohort</h2>
          <p class="mt-1 text-sm text-muted" data-i18n="cohorts.join.hint">Enter the invite code your teacher shared.</p>
          <form id="join-form" class="mt-3 flex gap-2">
            <input id="join-code" aria-label="Invite code" data-i18n-aria="cohorts.aria.invitecode" placeholder="e.g. 4F9A2C" data-i18n-ph="cohorts.ph.invitecode" maxlength="12"
              class="flex-1 rounded-xl border border-line bg-surface px-4 py-2.5 font-sans uppercase tracking-wider" />
            <button class="btn btn-primary" data-i18n="cohorts.join.button">Join</button>
          </form>
          <div id="join-out" class="mt-3 text-sm" aria-live="polite"></div>
        </div>`;
    }

    function teacherBox() {
      const opts = myCourses.map((id) => `<option value="${esc(id)}">${esc(titles[id] || id)}</option>`).join('');
      return `
        <div class="glass-strong mt-6 rounded-xl2 p-5">
          <h2 class="text-lg font-bold text-navy" data-i18n="cohorts.create.h2">Create a cohort</h2>
          <p class="mt-1 text-sm text-muted" data-i18n="cohorts.create.hint">Pick a course you teach and name the group. You'll get an invite code to share.</p>
          ${myCourses.length ? `
          <form id="create-form" class="mt-3 grid gap-2 sm:grid-cols-[1fr_1fr_auto]">
            <select id="c-course" aria-label="Course" data-i18n-aria="cohorts.aria.course" class="rounded-xl border border-line bg-surface px-3 py-2.5 font-sans">${opts}</select>
            <input id="c-name" aria-label="Cohort name" data-i18n-aria="cohorts.aria.cohortname" placeholder="e.g. Summer Camp 2026" data-i18n-ph="cohorts.ph.cohortname"
              class="rounded-xl border border-line bg-surface px-3 py-2.5 font-sans" />
            <button class="btn btn-primary" data-i18n="cohorts.create.button">Create</button>
          </form>` : `<p class="mt-3 rounded-xl border border-line bg-surface p-3 text-sm text-muted" data-i18n="cohorts.nocourses">No courses available to create a cohort for yet.</p>`}
          <div id="create-out" class="mt-3 text-sm" aria-live="polite"></div>
        </div>
        <div class="mt-6">
          <h2 class="text-lg font-bold text-navy" data-i18n="cohorts.yourcohorts.h2">Your cohorts</h2>
          <div id="cohort-list" class="mt-3 grid gap-3 sm:grid-cols-2"><p class="text-sm text-muted" data-i18n="cohorts.loading">Loading…</p></div>
        </div>
        <div id="roster" class="mt-6"></div>`;
    }

    function wireJoin() {
      document.getElementById('join-form').addEventListener('submit', async (e) => {
        e.preventDefault();
        const code = document.getElementById('join-code').value.trim();
        const out = document.getElementById('join-out');
        if (!code) return;
        out.textContent = 'Joining…';
        const r = await api('/api/cohorts', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ action: 'join', code }) });
        if (r.ok && r.data.ok) {
          out.innerHTML = `<span class="text-ok font-semibold">Joined ${esc(r.data.cohortName || 'the cohort')}.</span> <a class="underline text-navy" href="/course/${esc(r.data.courseId)}" data-i18n="cohorts.opencourse">Open the course →</a>`;
        } else {
          out.innerHTML = `<span class="text-danger">${esc(r.data.error || 'Could not join.')}</span>`;
        }
      });
    }

    async function loadCohorts() {
      const box = document.getElementById('cohort-list');
      const r = await api('/api/cohorts');
      if (!r.ok) { box.innerHTML = '<p class="text-sm text-muted" data-i18n="cohorts.loaderror">Could not load your cohorts.</p>'; return; }
      const cs = r.data.cohorts || [];
      if (!cs.length) { box.innerHTML = '<p class="text-sm text-muted" data-i18n="cohorts.empty">No cohorts yet — create one above.</p>'; return; }
      box.innerHTML = cs.map((c) => `
        <div class="glass-lite rounded-xl2 p-4">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <div>
              <div class="font-bold text-navy">${esc(c.name)}</div>
              <div class="font-sans text-xs text-muted">${esc(titles[c.course_id] || c.course_id)} · ${c.members} member${c.members === 1 ? '' : 's'}</div>
            </div>
            <div class="flex items-center gap-3">
              <span class="pill bg-saffron-soft text-saffron-deep font-mono tracking-widest">${esc(c.invite_code)}</span>
              <button class="btn text-sm" data-roster="${esc(c.id)}" data-i18n="cohorts.roster.button">Roster</button>
            </div>
          </div>
        </div>`).join('');
      box.querySelectorAll('[data-roster]').forEach((b) => b.addEventListener('click', () => loadRoster(b.getAttribute('data-roster'))));
    }

    async function loadRoster(id) {
      const box = document.getElementById('roster');
      box.innerHTML = '<p class="text-sm text-muted" data-i18n="cohorts.loadingroster">Loading roster…</p>';
      const r = await api('/api/cohorts?id=' + encodeURIComponent(id));
      if (!r.ok) { box.innerHTML = '<p class="text-sm text-muted" data-i18n="cohorts.rostererror">Could not load the roster.</p>'; return; }
      const roster = r.data.roster || [];
      const rows = roster.map((m) => `
        <tr>
          <td class="border border-line p-2">${esc(m.name)}</td>
          <td class="border border-line p-2 tabular-nums">${m.lessonsDone}</td>
          <td class="border border-line p-2 tabular-nums">${m.score == null ? '—' : m.score + '%'}</td>
          <td class="border border-line p-2">${m.passed ? '<span class="text-ok font-semibold" data-i18n="cohorts.status.passed">Passed</span>' : '<span data-i18n="cohorts.status.inprogress">In progress</span>'}</td>
        </tr>`).join('');
      box.innerHTML = `
        <div class="glass-strong rounded-xl2 p-5">
        <h2 class="text-lg font-bold text-navy">${esc(r.data.cohort.name)} <span data-i18n="cohorts.roster.title">— roster</span></h2>
        <p class="mt-1 text-sm text-muted">${roster.length} member${roster.length === 1 ? '' : 's'} · invite code <span class="font-mono tracking-widest">${esc(r.data.cohort.inviteCode)}</span></p>
        <div class="mt-3 overflow-x-auto">
          <table class="w-full border-collapse text-sm"><thead><tr class="bg-brand text-white font-sans text-xs">
            <th class="p-2 text-left" data-i18n="cohorts.th.member">Member</th><th class="p-2 text-left" data-i18n="cohorts.th.lessons">Lessons done</th><th class="p-2 text-left" data-i18n="cohorts.th.score">Best score</th><th class="p-2 text-left" data-i18n="cohorts.th.status">Status</th>
          </tr></thead><tbody>${rows || '<tr><td colspan="4" class="border border-line p-3 text-muted" data-i18n="cohorts.noroster">No members yet — share the invite code.</td></tr>'}</tbody></table>
        </div>
        </div>`;
    }

    function wireCreate() {
      const form = document.getElementById('create-form');
      if (!form) return; // no courses to teach yet — nothing to wire
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const courseId = document.getElementById('c-course').value;
        const name = document.getElementById('c-name').value.trim();
        const out = document.getElementById('create-out');
        if (!courseId || !name) { out.innerHTML = '<span class="text-danger" data-i18n="cohorts.pickcourse">Pick a course and a name.</span>'; return; }
        out.textContent = 'Creating…';
        const r = await api('/api/cohorts', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ action: 'create', courseId, name }) });
        if (r.ok && r.data.ok) {
          out.innerHTML = `<span class="text-ok font-semibold" data-i18n="cohorts.created">Created.</span> <span data-i18n="cohorts.invitecode.label">Invite code:</span> <span class="font-mono tracking-widest text-navy">${esc(r.data.inviteCode)}</span>`;
          document.getElementById('c-name').value = '';
          loadCohorts();
        } else {
          out.innerHTML = `<span class="text-danger">${esc(r.data.error || 'Could not create the cohort.')}</span>`;
        }
      });
      // ?course=<id> preselects the course (e.g. linked from the teacher dashboard
      // or Studio right after publishing) and focuses the name field.
      const presetCourse = new URLSearchParams(location.search).get('course');
      if (presetCourse && myCourses.includes(presetCourse)) {
        document.getElementById('c-course').value = presetCourse;
        document.getElementById('c-name').focus();
      }
    }

    async function init() {
      // Course titles for the picker + list labels (every course, so "Your cohorts"
      // can label a cohort even if this teacher's course_teachers row changed since).
      try { const d = await (await fetch('/data/index.json')).json(); d.courses.forEach((c) => (titles[c.id] = c.title)); } catch (e) {}
      const me = await api('/api/me');
      const user = me.data && me.data.user;
      if (!user) {
        app.innerHTML = `<div class="glass-strong rounded-xl2 p-5"><p class="text-muted"><span data-i18n="cohorts.please">Please</span> <a class="underline text-navy" href="/login" data-i18n="cohorts.signinlink">sign in</a> <span data-i18n="cohorts.signin.suffix">to join or create a cohort.</span></p></div>`;
        return;
      }
      const isTeacher = user.role === 'admin' || user.isTeacher;
      if (isTeacher) {
        const gb = await api('/api/gradebook');
        myCourses = (gb.ok && gb.data.courses) || [];
      }
      app.innerHTML = joinBox() + (isTeacher ? teacherBox() : '');
      wireJoin();
      if (isTeacher) { wireCreate(); loadCohorts(); }
    }
    init();
  </script>
</Base>
