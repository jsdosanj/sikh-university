/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  # The Content-Security-Policy lives in worker.js (single source of truth): the Worker
  # overrides response headers on HTML documents, so a CSP here would only ever apply to
  # non-document assets and diverge silently. Keep security headers here, CSP there.
